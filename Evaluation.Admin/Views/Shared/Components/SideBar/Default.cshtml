@using System.Text.RegularExpressions


@model SideBarVM
<!-- Sidebar Menu -->
@{
    var SideBars = Model.SideBar;
    var parentIndex = 0;
    string LogoURL = ViewBag.LogoURLSetting;
    string SessionExpire = ViewBag.SessionExpire;
    LogoURL = string.IsNullOrEmpty(LogoURL) ? (ViewBag.Lang == "ar") ? "/img/logo-icon.png" : "/img/logo-icon.png" : LogoURL;

}
<nav class="navbar bg-dark m-0 p-0">

    <div class="navbar-logo bg-dark">
        <a href="~/" class="header-logo">
            <img class="rounded-circle bg-light" src="@LogoURL" alt="" style="width: 40px; height: 40px;">
            <h6>The Ministry of Education and Higher Education</h6>
        </a>

        <!-- sidebar collapse-->
        <a href="#" class="sidebar-toggler flex-shrink-0 flex-grow-1 text-white" data-toggle="minimize"><i class="fa fa-bars"></i></a>
    </div>
    <div class="d-flex mx-2 ">
        <input type="hidden" value="@SessionExpire" id="textSessionExpire" />
        <input type="text" id="sidebarsearch" onkeyup="FilterSidebar('#menu');" class="form-control" />
    </div>

    <ul id="menu" class="nav w-100">
        @foreach (var item in SideBars.OrderBy(c => c.OrderNo))
        {
            var HasChild = item.ChildList?.Any() ?? false;
            var Permission = item.PermissionId;
            string ChildClass = HasChild ? "dropdown" : "";
            var trimname = Regex.Replace(item.Name, "[^a-zA-Z0-9\u0600-\u06FF]", "");
            parentIndex++;

            if (HasChild)
            {


                <li class="nav-item" id="@item.Id">
                    <a href="#@trimname" class="nav-link" data-bs-toggle="collapse" aria-bs-expanded="false" aria-controls="@trimname">
                        <i class="@item.Icon menu-icon"></i><span class="menu-title">@item.Name</span><i class="fa fa-chevron-down"></i>
                    </a>
                    <div class="collapse" id="@trimname">
                        <ul class="nav flex-column sub-menu">
                            @foreach (var child in item.ChildList!.OrderBy(c => c.OrderNo))
                            {
                                var RoutingMain = child.RoutingPath.Contains("/") ? child.RoutingPath.Split("/")[1] : "Index";
                                var RoutingPath = child.RoutingPath.Contains("/") ? child.RoutingPath.Split("/")[0] : child.RoutingPath;
                                <li class="nav-item" id="@child.Id"><a href="@Url.Action(@RoutingMain, RoutingPath)" class="nav-link"> @child.Name</a></li>
                            }
                        </ul>
                    </div>
                </li>
            }
            else
            {
                if (Permission != null)
                {
                    <li class="nav-item" id="@item.Id">
                        <a href="@Url.Action("Index", @item.RoutingPath)" class="nav-link" li-key="li-@item.Id">
                            <i class="@item.Icon menu-icon"></i>
                            <span class="menu-title"> @item.Name</span>
                        </a>

                    </li>
                }


            }

        }


    </ul>

</nav>

<!-- /.sidebar-menu -->