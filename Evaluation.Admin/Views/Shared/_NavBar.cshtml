@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Evaluation.SharedHelper.Models

@inject IOptions<RequestLocalizationOptions> LocOptions
@inject RequestInfo _requestInfo;

@{
    var RequestCulture = Context.Features.Get<IRequestCultureFeature>();
    
    var Lang = string.IsNullOrEmpty(_requestInfo.Lang) ? "ar" : _requestInfo.Lang ?? "ar";

    var Arabic = new SelectListItem() { Text = "Arabic", Value = "ar",Selected= Lang=="ar" ? true : false};
    var English = new SelectListItem() { Text = "English", Value = "en", Selected = Lang == "en" ? true : false };
    var CultureList = new List<SelectListItem>();
    CultureList.Add(Arabic);
    CultureList.Add(English);
    var ReturnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";

}
