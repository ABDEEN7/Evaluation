                            }
                            @if (permissionsList.IsPermissionAvailabe(AdminPermission.VIEW_ADMIN_ACTIONCONDITION))
                            {
                                <button type="button" class="nav-link tablinks" onclick="opentab(event, 'EvaluationActionConditionDiv')">@controlsList.GetUiControlText(AdminBackendUI.ActionConditionTab) </button>
                            }
                        </div>
                        <div id="EvaluationActionDtepDiv" class="card-body EvaluationActionDtepDiv tabcontent">


                            <div class=" row">

                                @if (permissionsList.IsPermissionAvailabe(AdminPermission.UPDATE_ADMIN_ACTION_FIELD))
