@using Evaluation.Admin.Extensions
@using static Evaluation.SharedHelper.Enums.ConstantKeys


@model TeamVM
@{

    string Lang = Model.CurrentLanguage;
    var uiControlItems = Model.UiControlItems.Where(x => x.RowOrder > 0 && x.Constraint.Permission.BackEndName == AdminPermission.ADD_ADMIN_TEAM).ToList();
    var UserTeamScopeuiControlItems = Model.UiControlItems.Where(x => x.RowOrder > 0 && x.Constraint.Permission.BackEndName == AdminPermission.ADD_ADMIN_USERTEAMSCOPE).ToList();
    var textDir = Lang == "ar" ? "RTL" : "LTR";
    var permissionsList = Model.PermissionsList;
    var controlsList = Model.ControlsList;
    var settingList = Model.SettingList;
    var containsOrderNo = Model.containsOrderNo;
    var columnList = Model.UiControlItems.Where(x => x.Constraint.ShowInGrid == true && x.Constraint.Permission.BackEndName == AdminPermission.ADD_ADMIN_TEAM).ToList();
    var UserTeamScopecolumnList = Model.UiControlItems.Where(x => x.Constraint.ShowInGrid == true && x.Constraint.Permission.BackEndName == AdminPermission.ADD_ADMIN_USERTEAMSCOPE).ToList();
}
@section Styles {
  
           }
<div class="sub-page-container">
    <section id="tbl-template-container" class="section-container">
        <div class="card app-card">
        <div class="card-header justify-content-end d-flex align-items-center bg-light">
                @if (permissionsList.IsPermissionAvailabe(AdminPermission.ADD_ADMIN_TEAM))
            {
                <button id="btn-add-content" type="button" class="btn btn-primary">
                    <i class="fa fa-plus-circle"></i> &nbsp;@controlsList.GetUiControlText(AdminBackendUI.ADD_RECORD)
                </button>
            }

        </div>
        <div class="card-body">
               
                <div id="view-container"></div>
        </div>
    </div>
</section>

<section class="display-none" id="form-section">
    <div class="card app-card">
        <form enctype="multipart/form-data" id="app-form">
            <input id="Id" hidden />
            <div class="card-header justify-content-end d-flex align-items-center bg-light"><div class="closeit">  <i class="fa fa-close"></i></div></div>
            <div class="card-body">
                    @if (uiControlItems!=null)
                {
                        <div class="row">
                        @{
                                @await Component.InvokeAsync("UiControlList", uiControlItems)
                        }
                    </div>
                }


                <div class="btns-group mb-0 mt-3" id="action-container">
                    <button type="button" id="btn-back" class="btn btn-secondary">@controlsList.GetUiControlText(AdminBackendUI.BACK_BUTTON)</button>
                    <button type="button" id="btn-submit" class="btn btn-primary">@controlsList.GetUiControlText(AdminBackendUI.SAVE_BUTTON)</button>
                </div>
            </div>
        </form>
    </div>
</section>
</div>

@section Scripts {
   
    <script src="~/js/admin/Team.js" asp-append-version="true"></script>
    <script>
         var controlsList = JSON.parse(`@Html.Raw(Json.Serialize(controlsList))`);
         var columnList = @Html.Raw(Json.Serialize(columnList));
           var UserTeamScopecolumnList = @Html.Raw(Json.Serialize(UserTeamScopecolumnList));
        const settingList = JSON.parse(`@Html.Raw(Json.Serialize(settingList))`);
         sharedFn().PopulateUiControl(controlsList);
         var lang='@Lang';
        let txtDir = '@textDir';
        let containsOrderNo='@containsOrderNo';
          const controlvalidationlist = @Html.Raw(Json.Serialize(uiControlItems));
          const UserTeamScopecontrolvalidationlist = @Html.Raw(Json.Serialize(UserTeamScopeuiControlItems));

        let IsEdit_Team='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.EDIT_ADMIN_TEAM))';
        let IsDelete_Team='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.DELETE_ADMIN_TEAM))';
        let IsView_Team='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.VIEW_ADMIN_TEAM))';

         let IsAdd_UserTeamScope='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.ADD_ADMIN_USERTEAMSCOPE))';
         let IsEdit_UserTeamScope='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.EDIT_ADMIN_USERTEAMSCOPE))';
        let IsDelete_UserTeamScope='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.DELETE_ADMIN_USERTEAMSCOPE))';
        let IsView_UserTeamScope='@Html.Raw(permissionsList.IsPermissionAvailabe(AdminPermission.VIEW_ADMIN_USERTEAMSCOPE))';
        
         
        sharedFn().InitializeControl(controlvalidationlist, settingList);
        
   </script>
    
    
}