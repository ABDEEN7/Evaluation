@{
    var modalId = ViewData["ModalId"] as string ?? "myModal";
}
<div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}Label")" aria-hidden="true">
    <div class="modal-dialog  modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header align-items-start border-0">
                <div>
                    <h4 class="modal-title fw-semibold mb-2" id="modalLabel"></h4>

                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="la la-close mt-1"></i></button>
            </div>
            <div class="modal-body py-0">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card card-table  mb-4">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary mb-3"> <i class="la la-building"></i> معلومات أساسية</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <p class="text-light">المدير</p>
                                        <h5 class="fw-bold" id="managerName"></h5>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="text-light">تاريخ الإنشاء</p>
                                        <h5 class="fw-bold" id="establishmentDate"></h5>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="text-light">المدرسون</p>
                                        <h5 class="fw-bold" id="teachers"></h5>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="text-light">الطلاب</p>
                                        <h5 class="fw-bold" id="students"></h5>
                                    </div>
                                </div>
                                <hr class="mt-0">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class=" d-flex gap-2 align-items-center mb-3">
                                            <div class="social-icon"><i class="la la-phone-volume"></i></div>
                                            <div><a id="phone" href="#" class="text-dark"></a></div>
                                        </div>
                                        <div class=" d-flex gap-2 align-items-center mb-3">
                                            <div class="social-icon"><i class="la la-envelope"></i></div>
                                            <div><a id="email" href="" class="text-dark"></a></div>
                                        </div>
                                        <div class=" d-flex gap-2 align-items-center mb-3">
                                            <div class="social-icon"><i class="la la-location-arrow"></i></div>
                                            <div><p id="address" class="text-dark m-0"></p></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-table  mb-4">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary mb-3"> <i class="la la-chart-bar"></i> الوضع الحالي</h5>
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <div class="bg-success-light p-3 text-center br-8 ">
                                            <p>التقييم الحالي</p>
                                            <h3>ممتاز</h3>
                                            <p>10-02-2025</p>
                                        </div>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <div class="bg-danger-light p-3 text-center br-8 ">
                                            <p>التقييم السابق</p>
                                            <h3>ضعيف</h3>
                                            <p>10-02-2025</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script src="~/js/school/schooldetails.js" asp-append-version="true"></script>


    <script type="text/javascript">

        //     $('#@modalId').on('shown.bs.modal', async function () {
        //   console.log('Modal is ready!');
        //      const button = event.relatedTarget; // The link that triggered the modal
        // const schoolId = button.getAttribute('data-id');
        // await initSchoolDetailsPage(schoolId);
        // $("#exampleModalLabel").text(schoolDetails.nameAr);

        //     });


                $(document).on('click', 'a[data-bs-target="#schoolDetailsModal"]',async function() {
            let schoolId = $(this).attr('data-id');
            console.log(schoolId);
                await initSchoolDetailsPage(schoolId);
        $("#modalLabel").text(schoolDetails.nameAr);
        $("#managerName").text(schoolDetails.manageEmail);
        $("#establishmentDate").text(schoolDetails.establishmentDate);
        $("#phone").text(schoolDetails.phone);
        $("#email").text(schoolDetails.orgEmail);
        $("#address").text(schoolDetails.address);


        });

    </script>
}