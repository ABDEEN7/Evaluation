@{
    var modalId = ViewData["ModalId"] as string ?? "myModal";
    var isModal = ViewBag.IsModal ?? true;
    var type = ViewBag.type;

    Func<object, Microsoft.AspNetCore.Html.IHtmlContent> content = @<text>
    @if (type == "SCHOOL")
    {
            <div class="col-md-6">
                <div class="card card-table mb-3">
                        <div class="card-body">
                        <h5 class="fw-bold mb-4">معلومات أساسية</h5>
                        <div>
                                <div class="row my-3">
                                    <div class="col-md-6">
                                            <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-user color-primary"></i>
                                            </span>

                                            <span class="mx-2">المدير</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6">
                                    <h6 class="text-light" id="managerName_@modalId">
                                
                                        </h6>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-calendar-check color-primary"></i>
                                            </span>

                                            <span class="mx-2">تاريخ الإنشاء</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6 justify-items-end">
                                    <h6 class="text-light" id="establishmentDate_@modalId"></h6>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-user-friends color-primary"></i>
                                            </span>

                                            <span class="mx-2">المراحل</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6 justify-items-end">
                                    <h6 class="text-light" id="teachers_@modalId">ابتدائي, اعدادي</h6>
                                    </div>
                                </div>
                           
                        </div>
                        <hr class="my-4">
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <span class="soft-gray-bg mp2">
                                        <i class="las la-phone-volume color-primary"></i>
                                    </span>
                            <div><a id="phone_@modalId" href="#" class="text-dark"></a></div>
                                </div>
                            
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <span class="soft-gray-bg mp2">
                                        <i class="las la-envelope color-primary"></i>
                                    </span>
                            <div><a id="email_@modalId" href="" class="text-dark"></a></div>
                                </div>
                           
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <span class="soft-gray-bg mp2">
                                        <i class="las la-location-arrow color-primary"></i>
                                    </span>
                            <div><p id="address_@modalId" class="text-dark m-0"></p></div>
                                </div>
                    </div>
                </div>
            </div>
    }
    else if (type == "EMPLOYEE")
    {
            <div class="col-md-6">
                <div class="card card-table mb-3">
                    <div class="card-body">
                            <h5 class="fw-bold mb-4">معلومات أساسية</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <p class="text-light">الرقم الوظيفي</p>
                                <h5 class="fw-bold" id="employeeNo_@modalId"></h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-light">تاريخ الميلاد</p>
                                <h5 class="fw-bold" id="birthDate_@modalId"></h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-light">الجنسية</p>
                                <h5 class="fw-bold" id="nationalityCode_@modalId"></h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-light">تاريخ الالتحاق</p>
                                <h5 class="fw-bold" id="joinDate_@modalId"></h5>
                                </div>
                            </div>
               
                        <hr class="mt-0">
                        <div class="row">
                            <div class="col-md-12">
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-phone-volume"></i></div>
                                    <div><a id="jobTitle_@modalId" href="#" class="text-dark"></a></div>
                                </div>
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-envelope"></i></div>
                                    <div><a id="email_@modalId" href="" class="text-dark"></a></div>
                                </div>
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-location-arrow"></i></div>
                                    <div><p id="qID_@modalId class="text-dark m-0"></p></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }

        <div class="col-md-6">
            <div class="card card-table  mb-4">
                <div class="card-body colored-card">
                <h5 class="fw-bold mb-4">الوضع الحالي</h5>
                        <div class="bg-success-light-no-color p-3 br-8">
                            <div class="row m-3">
                                <div class="col-md-8">
                                     <p><i class="las la-check-circle success-color"></i>
                                            التقييم
                                            الحالي
                                     </p>
                                </div>
                                <div class="col-md-4 justify-items-end"><p>10-02-2025</p></div>
                          
                               
                                 <p class="success-color-custom mx-3 my-1">ممتاز</p>
                           
                            </div>
                        </div>

                         <div class="bg-old-status-light-no-color p-3 br-8 mt-3">
                            <div class="row m-3">
                                <div class="col-md-8">
                                     <p><i class="las la-check-circle old-status-color"></i>
                                              التقييم السابق
                                     </p>
                                </div>
                                <div class="col-md-4 justify-items-end"><p>02-02-2024</p></div>
                          
                               
                                 <p class="old-status-color-custom mx-3 my-1">ضعيف</p>
                           
                            </div>
                        </div>
 
                </div>
            </div>
        </div>
    </text>;
}

@if (isModal)
{
    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}Label")" aria-hidden="true">
        <div class="modal-dialog  modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header align-items-start border-0">
                    <div>
                        <h4 class="modal-title fw-semibold mb-2" id="modalLabel_@modalId"></h4>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="la la-close mt-1"></i></button>
                </div>
                <div class="modal-body py-0">
                    <div class="row">
                        @content(null)
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        @content(null)
    </div>
}




@if (type == "SCHOOL")
    {
        <script type="text/javascript">
            $(document).on('click', 'a[data-bs-target="#@modalId"]', async function () {
                let ordId = $(this).attr('data-id');
                console.log(ordId);
                 let orgDetails =  await initSchoolDetailsPage(ordId);
                $("#modalLabel_@modalId").text(orgDetails.name);
        $("#managerName_@modalId").text(orgDetails.managerName);
            $("#establishmentDate_@modalId").text(orgDetails.establishmentDate);
            $("#phone_@modalId").text(orgDetails.phone);
            $("#email_@modalId").text(orgDetails.orgEmail);
            $("#address_@modalId").text(orgDetails.address);
            });
        </script>
    }
else if (type == "EMPLOYEE")
    {
        <script type="text/javascript">
            $(document).on('click', 'a[data-bs-target="#@modalId"]', async function () {
                let ordId = $(this).attr('data-id');
                console.log(ordId);
           let orgDetails =  await initSchoolDetailsPage(ordId);
            $("#modalLabel_@modalId").text(orgDetails.name);
            $("#employeeNo_@modalId").text(orgDetails.employeeNo);
            $("#birthDate_@modalId").text(orgDetails.birthDate);
            $("#nationalityCode_@modalId").text(orgDetails.nationalityCode);
            $("#joinDate_@modalId").text(orgDetails.joinDate);
            $("#jobTitle_@modalId").text(orgDetails.jobTitle);
            $("#email_@modalId").text(orgDetails.email);
            $("#qID_@modalId").text(orgDetails.qID);
            });
        </script>
    }