@{
    var modalId = ViewData["ModalId"] as string ?? "myModal";
    var isModal = ViewBag.IsModal ?? true;

    var Type = (modalId == "ORGANIZATION") ? "SCHOOL" : modalId;


    Func<object, Microsoft.AspNetCore.Html.IHtmlContent> content = @<text>
    @if (Type == "SCHOOL")
    {
            <div class="col-md-6">
                <div class="card card-table mb-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">معلومات أساسية</h5>
                        <div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                            <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-user color-primary"></i>
                                            </span>

                                            <span class="mx-2">المدير</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-light" id="managerName"></h6>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-calendar-check color-primary"></i>
                                            </span>

                                            <span class="mx-2">تاريخ الإنشاء</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6 justify-items-end">
                                        <h6 class="text-light" id="establishmentDate"></h6>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-user-friends color-primary"></i>
                                            </span>

                                            <span class="mx-2">المدرسون</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6 justify-items-end">
                                        <h6 class="text-light" id="teachers"></h6>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold">
                                            <span class="primary-bg">
                                                <i class="las la-graduation-cap color-primary"></i>
                                            </span>

                                            <span class="mx-2">الطلاب</span>
                                        </h6>
                                    </div>
                                    <div class="col-md-6 justify-items-end">
                                        <h6 class="text-light" id="students"></h6>
                                    </div>
                                </div>
                        </div>
                        <hr class="my-4">
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div><i class="la la-phone-volume"></i></div>
                                    <div><a id="phone" href="#" class="text-dark"></a></div>
                                </div>
                            
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div><i class="la la-envelope"></i></div>
                                    <div><a id="email" href="" class="text-dark"></a></div>
                                </div>
                           
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div><i class="la la-location-arrow"></i></div>
                                    <div><p id="address" class="text-dark m-0"></p></div>
                                </div>
                    </div>
                </div>
            </div>
    }
    else if (Type == "EMPLOYEE")
    {
            <div class="col-md-6">
                <div class="card card-table  mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">معلومات أساسية</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <p class="text-light">الرقم الوظيفي</p>
                                <h5 class="fw-bold" id="employeeNo"></h5>
                            </div>
                            <div class="col-md-6 mb-3">
                                <p class="text-light">تاريخ الميلاد</p>
                                <h5 class="fw-bold" id="birthDate"></h5>
                            </div>
                            <div class="col-md-6 mb-3">
                                <p class="text-light">الجنسية</p>
                                <h5 class="fw-bold" id="nationalityCode"></h5>
                            </div>
                            <div class="col-md-6 mb-3">
                                <p class="text-light">تاريخ الالتحاق</p>
                                <h5 class="fw-bold" id="joinDate"></h5>
                            </div>
                        </div>
                        <hr class="mt-0">
                        <div class="row">
                            <div class="col-md-12">
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-phone-volume"></i></div>
                                    <div><a id="jobTitle" href="#" class="text-dark"></a></div>
                                </div>
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-envelope"></i></div>
                                    <div><a id="email" href="" class="text-dark"></a></div>
                                </div>
                                <div class=" d-flex gap-2 align-items-center mb-3">
                                    <div class="social-icon"><i class="la la-location-arrow"></i></div>
                                    <div><p id="qID" class="text-dark m-0"></p></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }

        <div class="col-md-6">
            <div class="card card-table  mb-4">
                <div class="card-body">
                <h5 class="fw-bold mb-4">الوضع الحالي</h5>
                        <div class="bg-success-light-no-color p-3 br-8">
                            <div class="row m-3">
                                <div class="col-md-8">
                                     <p><i class="las la-check-circle success-color"></i>
                                            التقييم
                                            الحالي
                                     </p>
                                </div>
                                <div class="col-md-4 justify-items-end"><p>10-02-2025</p></div>
                          
                               
                                 <p class="success-color-custom mx-3 my-1">ممتاز</p>
                           
                            </div>
                        </div>


                            <div class="col-md-12 mb-3">
                                <div class="bg-danger-light-no-color p-3 br-8">
                                    <p>
                                        <i class="las la-check-circle danger-color"></i>
                                        التقييم السابق
                                    </p>
                                    <h3 class="danger-color">ضعيف</h3>
                                    <p>10-02-2025</p>
                                </div>
                            </div>

                  
                </div>
            </div>
        </div>
    </text>;
}

@if (isModal)
{
    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}Label")" aria-hidden="true">
        <div class="modal-dialog  modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header align-items-start border-0">
                    <div>
                        <h4 class="modal-title fw-semibold mb-2" id="modalLabel"></h4>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="la la-close mt-1"></i></button>
                </div>
                <div class="modal-body py-0">
                    <div class="row">
                        @content(null)
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        @content(null)
    </div>
}

@section Scripts {

    <script src="~/js/org/orgdetails.js" asp-append-version="true"></script>

    @if (Type == "SCHOOL")
    {
        <script type="text/javascript">
            $(document).on('click', 'a[data-bs-target="#@modalId"]', async function () {
                let ordId = $(this).attr('data-id');
                console.log(ordId);
                await initSchoolDetailsPage(ordId);
                $("#modalLabel").text(orgDetails.name);
                $("#managerName").text(orgDetails.manageName);
                $("#establishmentDate").text(orgDetails.establishmentDate);
                $("#phone").text(orgDetails.phone);
                $("#email").text(orgDetails.orgEmail);
                $("#address").text(orgDetails.address);
            });
        </script>
    }
    else if (Type == "EMPLOYEE")
    {
        <script type="text/javascript">
            $(document).on('click', 'a[data-bs-target="#@modalId"]', async function () {
                let ordId = $(this).attr('data-id');
                console.log(ordId);
                await initSchoolDetailsPage(ordId);
                $("#modalLabel").text(orgDetails.name);
                $("#employeeNo").text(orgDetails.employeeNo);
                $("#birthDate").text(orgDetails.birthDate);
                $("#nationalityCode").text(orgDetails.nationalityCode);
                $("#joinDate").text(orgDetails.joinDate);
                $("#jobTitle").text(orgDetails.jobTitle);
                $("#email").text(orgDetails.email);
                $("#qID").text(orgDetails.qID);
            });
        </script>
    }
}