<!DOCTYPE html>
<html lang="en" class="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>وزارة التربية والتعليم والتعليم العالي</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="~/assets/img/moe-logo2.png" rel="icon">
    <link href="~/assets/img/moe-logo2.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;500;600;700;800;900;1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css">

    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css">

    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    <!-- Vendor JS Files -->
    <script src='~/assets/js/jquery.min.js'></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script src="~/js/shared/ajax-setup.js" asp-append-version="true"></script>
    <script src="~/js/shared/general-params.js"></script>
    <script src="~/js/shared/shared-utility.js" asp-append-version="true"></script>
    <script src="~/js/shared/jq-client-util.js" asp-append-version="true"></script>

    <!-- Template Main JS File -->
    <script src="~/assets/js/main.js"></script>


</head>

<body>
    <!-- ======= Top Bar ======= -->
    <div id="topbar"></div>
    <!-- ======= Header ======= -->
    <header id="header" class="fixed-top wow slideInDown animated" data-wow-duration="0.75s" data-wow-delay="0s">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-8 col-7"><div class="d-flex align-items-center"><i class="bi bi-list mobile-nav-toggle"></i><a href="/Home/Index" class="logo"><img src="~/assets/img/logo-en.png" alt="" class="img-fluid"></a></div></div>
                <div class="col-lg-9 col-md-4 col-5">
                    <div class="main-navbar d-flex align-items-center justify-content-between">
                        <nav id="navbar" class="navbar">
                            <ul class="px-3">
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/Index"><i class="fa fa-home"></i></a>
                                </li>
                                <li><a class="nav-link" href="#">دليل المستخدم</a></li>

                            </ul>
                        </nav><!-- .navbar -->
                        <div class="social-media px-3">
                            <a href="/Home/Index" class="btn"> <span class="d-none d-md-block"><i class="fas fa-globe"></i>&nbsp;&nbsp;Arabic</span><span class="d-block d-md-none">Ar</span></a>
                            <a id="loginLink" href="/Authentication/Login" class="btn btn-getstarted btn-sm">تسجيل دخول</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </header><!-- End Header -->
    @RenderBody()

    <footer id="footer" class="footer">
        <div class="container copyright text-center"><p>جميع حقوق الملكية محفوظة © 2025 وزارة التربية والتعليم والتعليم العالي .</p></div>
    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="fa-solid fa-arrow-up"></i></a>

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>