<div class="filter-section mb-3">
    <div class="row">
        <div class="col-md-3">
            <label>المدرسة</label>
            <input id="operationsSchoolFilter" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>المقيّم</label>
            <input id="operationsEvaluatorFilter" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>حالة التقييم</label>
            <select id="operationsStatusFilter" class="form-select">
                <option value="">الكل</option>
                <option value="NotStarted">لم يبدأ</option>
                <option value="InProgress">جاري</option>
                <option value="Completed">منتهي</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end justify-content-end">
            <button id="searchOperationsBtn" class="btn btn-primary">بحث</button>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered" id="evaluationOperationsTable">
        <thead>
            <tr>
                <th>رقم العملية</th>
                <th>المدرسة</th>
                <th>المقيّم</th>
                <th>تاريخ البداية</th>
                <th>تاريخ الانتهاء</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
