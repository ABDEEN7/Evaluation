@using Evaluation.SharedHelper.Enums
@* <script src="~/lib/flatpickr/l10n/ar.js"></script>
<script src="~/lib/flatpickr/l10n/default.js"></script> *@
<div class="m-4">

    <!-- Filter Header -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">

            <!-- View Toggle Buttons -->
            <div class="btn-group" role="group">
                <button id="cardViewEvaluationRequest" type="button"
                        class="btn btn-outline-primary active btn-icon-no-text">
                    <i class="la la-th-large"></i>
                </button>
                <button id="tblViewEvaluationRequest" type="button"
                        class="btn btn-outline-secondary btn-icon-no-text">
                    <i class="la la-list"></i>
                </button>
            </div>

            <!-- Advanced Search Button -->
            <button id="advancedSearchEvaluationRequestBtn"
                    type="button"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="la la-filter"></i>
                @* <span class="@ConstantKeys.EvaluationOperations.AdvancedSearch"></span> *@
            </button>

        </div>
    </div>

    <!-- Filter Form (hidden by default, toggled by Advanced Search) -->
    <form id="evaluation-request-filter-form-id" style="display:none;">

        <div class="mb-3 filter-section">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label @ConstantKeys.EvaluationOperations.RequestNo"></label>
                    <input id="evaluationRequestNoFilter"
                           class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label class="form-label @ConstantKeys.EvaluationOperations.PlanName"></label>
                    <select id="evaluationPlanIdFilter"
                            class="form-select filter-enter">
                        <option value="">@ConstantKeys.EvaluationOperations.All</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label @ConstantKeys.EvaluationOperations.School"></label>
                    <input id="evaluationOrgTreeFilter"
                           class="form-control filter-enter" />
                </div>

                <div class="col-lg-4 col-sm-12">
                    <label class="form-label @ConstantKeys.EvaluationOperations.Status"></label>
                    <select id="evaluationRequestStatusFilter"
                            class="form-select w-100">
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label @ConstantKeys.EvaluationOperations.PlanStartDate"></label>
                  
                    <input id="evaluationRequestDateFrom"
                           type="text"
                           class="form-control filter-enter datePicker" />
                </div>

                <div class="col-md-4">
                    <label class="form-label @ConstantKeys.EvaluationOperations.PlanEndDate"></label>
                    <input id="evaluationRequestDateTo"
                           type="text"
                           class="form-control filter-enter datePicker" />
                </div>

            </div>

          @*   <!-- Filter Action Buttons -->
             <div class="row mt-4">
                <div class="col-lg-4 col-sm-12">
                    <!-- empty spacer -->
                </div>
                <div class="col-lg-4 col-sm-12">
                    <!-- empty spacer -->
                </div>
                <div class="col-lg-4 col-sm-12">
                    <div class="d-flex gap-2 justify-content-end">
                        <button id="filterEvaluationRequestBtnId"
                                type="button"
                                class="btn btn-primary @ConstantKeys.EvaluationPlanRequests.lblApplyFilter">
                        </button>
                        <button id="clearFilterEvaluationRequestBtnId"
                                type="button"
                                class="btn btn-outline-secondary @ConstantKeys.EvaluationPlanRequests.lblClear">
                        </button>
                    </div>
                </div>
            </div>  *@







            <!-- Filter Action Buttons -->
            <div class="row mt-4">
                <div class="col-lg-8 col-sm-12"></div>
                <div class="col-lg-4 col-sm-12">
                    <div class="d-flex gap-2 justify-content-end">
                        <button id="filterEvaluationRequestBtnId"
                                type="button"
                                class="btn btn-primary @ConstantKeys.WebSchools.Search">
                        </button>
                        <button id="clearFilterEvaluationRequestBtnId"
                                type="button"
                                class="btn btn-outline-secondary @ConstantKeys.WebSchools.ClearFilter">
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </form>

</div>

<!-- Table -->
<div class="table-responsive">
    <table class="table table-striped table-bordered w-100 application-request card table-card-seperate-styling"
           id="evaluationRequestTable">

        <thead>
            <tr>
                <th>Operation</th>
                <th class="@ConstantKeys.EvaluationOperations.Status"></th>
                <th class="@ConstantKeys.EvaluationOperations.School"></th>
                <th class="@ConstantKeys.EvaluationOperations.PlanName"></th>
                <th>Period</th>
              
                <th class="@ConstantKeys.EvaluationOperations.CreatedDate"></th>
                <th class="@ConstantKeys.EvaluationOperations.CreatedTime"></th>
            </tr>
        </thead>

        <tbody class="requeststableBody"></tbody>

    </table>
</div>

<!-- Modal -->
<div class="modal fade"
     id="evaluationRequestModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header align-items-start border-0 justify-content-between">
                <div class="w-100">

                    <div class="row align-items-start">

                        <div class="col-md-9">
                            <div class="d-flex gap-3 align-items-center mb-2 heading">

                                <i class="la la-angle-left fs-32"></i>

                                <div>
                                    <h3 class="fw-bold m-0 @ConstantKeys.EvaluationOperations.RequestDetails"
                                        id="evaluationRequestModalLabel">
                                    </h3>

                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">

                                            <li class="breadcrumb-item">
                                                <a href="#"
                                                   class="@ConstantKeys.EvaluationOperations.PlanRequests">
                                                </a>
                                            </li>

                                            <li class="breadcrumb-item active" dir="ltr">
                                                @ConstantKeys.EvaluationOperations.RequestNo :
                                                <strong id="evaluationRequestNoText"></strong>
                                                /
                                                <strong id="evaluationRequestStatusText"></strong>
                                            </li>

                                        </ol>
                                    </nav>
                                </div>

                            </div>
                        </div>

                        <div class="col-md-3 d-flex justify-content-end align-items-start gap-2">
                          


                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal" aria-label="Close">
                                <i class="la la-close me-1 fs-14"></i><span class="close-text">Close</span>
                            </button>
                        </div>

                    </div>

                </div>
            </div>

            <div class="modal-body py-0">
                <div class="card card-table mb-4">
                    <div class="card-body">
                        <div id="evaluation-request-details-container"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.getElementById("advancedSearchEvaluationRequestBtn")
            .addEventListener("click", function () {
                var form = document.getElementById("evaluation-request-filter-form-id");
                if (form.style.display === "none" || form.style.display === "") {
                    form.style.display = "block";
                } else {
                    form.style.display = "none";
                }
            });

    });
</script>