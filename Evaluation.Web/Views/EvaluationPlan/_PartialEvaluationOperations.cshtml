@using Evaluation.SharedHelper.Enums

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="btn-group" role="group" aria-label="View mode">
            <button id="cardViewEvaluationRequest"
                    type="button"
                    class="btn btn-outline-primary active">
                <i class="la la-th-large"></i>
                @ConstantKeys.EvaluationOperations.CardView
            </button>

            <button id="tblViewEvaluationRequest"
                    type="button"
                    class="btn btn-outline-secondary">
                <i class="la la-list"></i>
                @ConstantKeys.EvaluationOperations.TableView
            </button>
        </div>

        <div class="d-flex gap-2">
            <button id="filterEvaluationRequestBtnId"
                    class="btn btn-primary">
                @ConstantKeys.EvaluationOperations.ApplyFilter
            </button>

            <button id="clearFilterEvaluationRequestBtnId"
                    class="btn btn-outline-secondary">
                @ConstantKeys.EvaluationOperations.Clear
            </button>
        </div>

    </div>

    <div class="card-body">
        <form id="evaluation-request-filter-form-id">
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.RequestNo
                    </label>
                    <input id="evaluationRequestNoFilter" class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.PlanName
                    </label>
                    <select id="evaluationPlanIdFilter" class="form-select filter-enter">
                        <option value="">
                            @ConstantKeys.EvaluationOperations.All
                        </option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.School
                    </label>
                    <input id="evaluationOrgTreeFilter" class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.Status
                    </label>
                    <select id="evaluationRequestStatusFilter" class="form-select filter-enter"></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.PlanStartDate
                    </label>
                    <input id="evaluationRequestDateFrom" type="date" class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        @ConstantKeys.EvaluationOperations.PlanEndDate
                    </label>
                    <input id="evaluationRequestDateTo" type="date" class="form-control filter-enter" />
                </div>

            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered w-100 application-request card"
           id="evaluationRequestTable">

        <thead>
            <tr>
                <th>@ConstantKeys.EvaluationOperations.PlanName</th>
                <th>@ConstantKeys.EvaluationOperations.Status</th>
                <th>@ConstantKeys.EvaluationOperations.School</th>
                <th>@ConstantKeys.EvaluationOperations.RequestNo</th>
                <th>@ConstantKeys.EvaluationOperations.CreatedDate</th>
                <th>@ConstantKeys.EvaluationOperations.CreatedTime</th>
            </tr>
        </thead>

        <tbody class="requeststableBody"></tbody>
    </table>
</div>

<div class="modal fade" id="evaluationRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header align-items-start border-0 justify-content-between">
                <div class="w-100">

                    <div class="row align-items-start">
                        <div class="col-md-9">

                            <div class="d-flex gap-3 align-items-center mb-2 heading">
                                <i class="la la-angle-left fs-32"></i>

                                <div>
                                    <h3 class="fw-bold m-0"
                                        id="evaluationRequestModalLabel">
                                        @ConstantKeys.EvaluationOperations.RequestDetails
                                    </h3>

                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">

                                            <li class="breadcrumb-item">
                                                <a href="#">
                                                    @ConstantKeys.EvaluationOperations.PlanRequests
                                                </a>
                                            </li>

                                            <li class="breadcrumb-item active">
                                                @ConstantKeys.EvaluationOperations.RequestNo :
                                                <strong id="evaluationRequestNoText"></strong>
                                            </li>

                                        </ol>
                                    </nav>
                                </div>
                            </div>

                        </div>

                        <div class="col-md-3 d-flex justify-content-end align-items-start gap-2">
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                                <i class="la la-close mt-1"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-body py-0">
                <div class="card card-table mb-4">
                    <div class="card-body">
                        <div id="evaluation-request-details-container"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>