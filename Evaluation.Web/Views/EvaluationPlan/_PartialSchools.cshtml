@using Evaluation.SharedHelper.Enums

<div class="m-4">


        <!-- Filter Section -->
        <form id="school-filter-form-id">
            <div class="row g-3">

                <div class="col-md-4">
                    <label for="schoolNameFilter" class="form-label @ConstantKeys.WebSchools.SchoolName"></label>
                    <input id="schoolNameFilter" class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label for="schoolCodeFilter" class="form-label @ConstantKeys.WebSchools.SchoolCode"></label>
                    <input id="schoolCodeFilter" class="form-control filter-enter" />
                </div>

                <div class="col-md-4">
                    <label for="schoolPhaseFilter" class="form-label @ConstantKeys.WebSchools.Phase"></label>
                    <select id="schoolPhaseFilter" class="form-select filter-enter">
                        <option value="">الكل</option>
                        <option value="1">ابتدائية</option>
                        <option value="2">إعدادية</option>
                        <option value="3">ثانوية</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="schoolTypeFilter" class="form-label @ConstantKeys.WebSchools.Type"></label>
                    <select id="schoolTypeFilter" class="form-select filter-enter">
                        <option value="">الكل</option>
                        <option value="1">حكومية</option>
                        <option value="2">خاصة</option>
                        <option value="3">دولية</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="schoolRegionFilter" class="form-label @ConstantKeys.WebSchools.Region"></label>
                    <select id="schoolRegionFilter" class="form-select filter-enter">
                        <option value="">الكل</option>
                        <option value="1">الدوحة</option>
                        <option value="2">الريان</option>
                        <option value="3">الوكرة</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="schoolStatusFilter" class="form-label @ConstantKeys.WebSchools.CurrentPlanStatus"></label>
                    <select id="schoolStatusFilter" class="form-select filter-enter">
                        <option value="">الكل</option>
                        <option value="1">لم تبدأ</option>
                        <option value="2">جارية</option>
                        <option value="3">مكتملة</option>
                    </select>
                </div>
            </div>
        </form>












    <div class="p-0 my-4">
        <div class="row">
            <div class="col-lg-4 col-sm-12 text-align-end">
                <div class=" d-flex justify-content-start align-items-center">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button id="cardViewSchool" type="button" class="btn btn-outline-primary active btn-icon-no-textn">
                            <i class="la la-th-large"></i>
                        </button>
                        <button id="tblViewSchool" type="button" class="btn btn-outline-secondary btn-icon-no-text">
                            <i class="la la-list"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-sm-12"></div>
            <div class="col-lg-4 col-sm-12 justify-content-end align-items-center">
                <div class="d-flex gap-3">
                    <button id="filterSchoolBtnId" class="btn btn-primary btn-with-text-icon w-100 mt-2">
                        <i class="la la-search @ConstantKeys.WebSchools.Search"></i>

                    </button>
                    <button id="clearFilterSchoolBtnId" class="btn btn-outline-secondary btn-with-text-icon w-100 mt-2">
                        <i class="la la-undo @ConstantKeys.WebSchools.ClearFilter"></i>

                    </button>
                </div>
            </div>
        </div>
    </div>







        <!-- Schools Table -->
        <div class="table-responsive" id="schoolsTableWrapper">
            <table id="schoolTable" class="table table-striped table-bordered w-100 application-request card">
                <thead>
                    <tr>
                        <th class="@ConstantKeys.WebSchools.Name"></th>
                        <th class="@ConstantKeys.WebSchools.Code"></th>
                        <th class="@ConstantKeys.WebSchools.TypeCol"></th>
                        <th class="@ConstantKeys.WebSchools.LevelsCol"></th>
               @*         <th class="@ConstantKeys.WebSchools.RegionCol"></th>
                        <th @ConstantKeys.WebSchools.StatusCol></th> *@
                    </tr>
                </thead>
                <tbody class="requeststableBody w-100"></tbody>
            </table>
        </div>

</div>
@* @await Component.InvokeAsync("SchoolDetailsModal", new { modalId = "SCHOOL", title = "تفاصيل المدرسة", body = "" }) *@

@await Component.InvokeAsync("SchoolDetailsModal", new { modalId = "schoolDetailsPopup", title = "تفاصيل المدرسة", body = "", isModal = true, type = "SCHOOL" })



