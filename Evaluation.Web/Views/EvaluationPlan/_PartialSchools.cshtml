@using Evaluation.SharedHelper.Enums

<div class="m-4">

    <!-- Toolbar Row -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">

            <!-- Left: View Toggle -->
            <div class="btn-group" role="group" aria-label="View mode">
                <button id="cardViewSchool" type="button"
                        class="btn btn-outline-primary active btn-icon-no-text">
                    <i class="la la-th-large"></i>
                </button>
                <button id="tblViewSchool" type="button"
                        class="btn btn-outline-secondary btn-icon-no-text">
                    <i class="la la-list"></i>
                </button>
            </div>

            <!-- Right: Filter Toggle Button -->
            <button id="advancedSearchSchoolBtn"
                    type="button"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="la la-filter"></i>
                @* <span class="@ConstantKeys.WebSchools.Search"></span> *@
            </button>

        </div>
    </div>

    <!-- Filter Form: hidden by default -->
    <div id="school-filter-wrapper" style="display:none;">
        <div class="filter-section mb-3">
            <form id="school-filter-form-id">
                <div class="row">

                    <div class="col-md-4">
                        <label for="schoolNameFilter"
                               class="form-label @ConstantKeys.WebSchools.SchoolName"></label>
                        <input id="schoolNameFilter" class="form-control filter-enter" />
                    </div>
                    <div class="col-md-4"></div>
                    <div class="col-md-4 col-sm-12 align-self-end">
                        <div class="d-flex gap-2 justify-content-end align-self-end">
                            <button id="filterSchoolBtnId"
                                    type="button"
                                    class="btn btn-primary @ConstantKeys.WebSchools.Search">
                            </button>
                            <button id="clearFilterSchoolBtnId"
                                    type="button"
                                    class="btn btn-outline-secondary @ConstantKeys.WebSchools.ClearFilter">
                            </button>
                        </div>
                    </div>







