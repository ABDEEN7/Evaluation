    <script src="~/lib/dualselectlist/js/dualselectlist.js" asp-append-version="true"></script>
    <script src="~/js/EvaluationPlan/createrequest.js" asp-append-version="true"></script>
    <script src="~/lib/uuid/uuid.min.js" asp-append-version="true"></script>
    <script type="text/javascript">
      

        $(document).ready(async function () {


            webAppConfigsSetup().Init({
                pageNames: [
                    '@typeof(ConstantKeys.WebAppCommon).Name',
                    '@typeof(ConstantKeys.EvaluationPlanRequests).Name',
                ],
                additional_keys: []
            }).then(() => {
                //uiControlsSetup().UpdatPageTitle('WebAppCreateRequest');
                $('body').show();
                //InitNavbarSection();
                const formUtility = FormGeneratorsUtility();
                formUtility.LoadAllCssClasses();
                InitializeCreateRequest();

            });

        });

        $(document).on('click', '.view-attachment', async function () {
            const id = $(this).data('id');
            const name = $(this).data('name');

            await formUtility.ViewAttac(id, name);
        });

     
    </script>

}
      