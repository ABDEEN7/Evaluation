    <script src="~/lib/tinymce/plugins/media/plugin.min.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/plugins/table/plugin.min.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/plugins/textcolor/plugin.min.js" asp-append-version="true"></script>
