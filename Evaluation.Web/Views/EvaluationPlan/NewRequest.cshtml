    <script src="~/lib/tabulator/js/tabulator.js" asp-append-version="true"></script>
<script src="~/js/shared/form-generation-utility.js" asp-append-version="true"></script>
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/select2/dist/js/select2.min.js" asp-append-version="true"></script>

    <script src="~/lib/select2/dist/js/select2.js" asp-append-version="true"></script>

    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/tinymce.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/theme.min.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/plugins/charmap/plugin.min.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/plugins/code/plugin.min.js" asp-append-version="true"></script>
