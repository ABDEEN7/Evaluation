<section id="evaluation" class="banner p-4">
    <div class="card container-fluid container-xxxl px-4 pt-1">
        <div class="row">
            <div class="col-lg-12 p-0">
                <ul class="nav nav-tabs row main-tabs bg-grey">
                    <li id="tabEvaluationPlans" class="nav-item col-md-4">
                        <a class="nav-link text-center active fs-6" data-bs-toggle="tab" href="#tab-plans">
                            <span class="my-1 @ConstantKeys.EvaluationForm.TabEvaluationPlans"></span>
                        </a>
                    </li>
                    <li id="tabEvaluationOperations" class="nav-item col-md-4">
                        <a class="nav-link fs-6 text-center" data-bs-toggle="tab" href="#tab-operations">
                            <span class="my-1 @ConstantKeys.EvaluationForm.TabEvaluationOperations"></span>
                            <span id="evaluationOperationsCount" class="badge ms-2"
                                  style="background:#89153D;color:#fff;border-radius:20px;padding:2px 8px;font-size:11px;display:none;">
                                0
                            </span>
                        </a>
                    </li>
                    <li id="tabSchools" class="nav-item col-md-4">
                        <a class="nav-link fs-6 text-center" data-bs-toggle="tab" href="#tab-schools">
                            <span class="my-1 @ConstantKeys.EvaluationForm.TabSchools"></span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="col-lg-12 p-0">
                <div class="tab-content">

                    <!-- Tab: Evaluation Plans -->
                    <div id="tab-plans" class="tab-pane fade show active">
                        <ul class="nav nav-tabs sub-tabs m-4">
                            <li class="nav-item">
                                <a class="nav-link active fs-6 @ConstantKeys.EvaluationForm.SubTabPlanRequests"
                                   data-bs-toggle="tab" href="#tab-plan-requests"></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fs-6 @ConstantKeys.EvaluationForm.SubTabPlanDetails"
                                   data-bs-toggle="tab" href="#tab-plan-details"></a>
                            </li>
                        </ul>
                        <div class="card tab-content m-4">
                            <div id="tab-plan-requests" class="tab-pane fade show active">
                                <partial name="_PartialEvaluationPlanRequests" />
                            </div>
                            <div id="tab-plan-details" class="tab-pane fade">
                                <partial name="_PartialEvaluationPlans" />
                            </div>
                        </div>
                    </div>

                    <!-- Tab: Evaluation Operations -->
                    <div id="tab-operations" class="tab-pane fade">
                        <partial name="_PartialEvaluationOperations" />
                    </div>

                    <!-- Tab: Schools -->
                    <div id="tab-schools" class="tab-pane fade">
                        <partial name="_PartialSchools" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- evaluationRequestDetailsModal -->
<div class="modal fade" id="evaluationRequestDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header align-items-center border-0 justify-content-between py-0 px-0"
                 style="background:#6B1E35; direction:rtl;">

                <div class="d-flex align-items-center px-4 py-3" style="flex:1; min-width:0;">
                    <h4 class="fw-bold m-0 text-white text-truncate fs-18"
                        id="breadcrumbSchoolName"></h4>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2 px-4 py-3 flex-shrink-0">
                    <div class="dropdown" id="actions-container"></div>

                    <button type="button"
                            class="btn btn-sm d-flex align-items-center gap-1"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                            style="background:rgba(255,255,255,0.12); color:#fff;
                       border:1px solid rgba(255,255,255,0.28);
                       border-radius:7px; font-family:Tajawal,sans-serif;
                       font-size:13px; font-weight:500;">
                        <i class="la la-close fs-14"></i>
                        <span class="close-text">إغلاق</span>
                    </button>
                </div>
            </div>

            <div class="d-flex align-items-start justify-content-between flex-wrap px-4 pt-4 gap-3 modal-desc-breadcrumb">

                <div class="d-flex flex-column align-items-start gap-2">

                    <nav aria-label="breadcrumb" class="m-0">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">
                                <a href="#"
                                   id="evaluationRequeststatus"
                                   class="@ConstantKeys.EvaluationForm.BreadcrumbSchool modal-desc-breadcrumb-a">
                                </a>
                            </li>
                            <li class="breadcrumb-item active d-flex align-items-center gap-1" aria-current="page">
                                <span class="@ConstantKeys.EvaluationForm.BreadcrumbRequestNo"></span>
                                <strong id="evaluationRequestNo"></strong>
                            </li>
                        </ol>
                    </nav>

                    <div id="evaluationDateRangeContainer"
                         class="d-flex align-items-center gap-2 flex-wrap">
                    </div>

                </div>

                <div id="evaluationDateBadgesContainer"
                     class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
                </div>

            </div>
            <div class="modal-body py-0">

                <div id="evaluationRequestDetailsModal_divTemplates" class="py-4" style="direction:rtl;"></div>

                <div class="card card-table mb-4">
                    <div class="card-body">
                        <div class="accordion" id="customAccordion">

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button d-flex align-items-center justify-content-between"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#itemSchool" aria-expanded="true">
                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="la la-building text-primary fs-25"></i>
                                            <span class="fw-semibold @ConstantKeys.EvaluationForm.AccordionSchoolBasicData"></span>
                                        </div>
                                        <span class="toggle-icon"><i class="la la-angle-up fs-22"></i></span>
                                    </button>
                                </h2>
                                <div id="itemSchool" class="accordion-collapse collapse show">
                                    <div class="accordion-body">
                                        <div id="school-details-container"></div>

                                        <div id="NDAContainerDiv"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item mb-3 rounded" id="formAccordionItem">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed d-flex align-items-center justify-content-between"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#itemForm">
                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="las la-clipboard text-primary fs-25"></i>
                                            <span class="fw-semibold @ConstantKeys.EvaluationForm.AccordionSchoolData"></span>
                                        </div>
                                        <span class="toggle-icon"><i class="la la-angle-up fs-22"></i></span>
                                    </button>
                                </h2>
                                <div id="itemForm" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        <div class="accordion" id="formGroupsAccordion"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item mb-3 rounded d-none" id="forceAssignmentAccordion">

                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#itemForceAssignments">

                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="las la-user-shield text-primary fs-25"></i>
                                            <span class="fw-semibold">
                                                 Assignments
                                            </span>
                                        </div>

                                        <span class="toggle-icon">
                                            <i class="la la-angle-up fs-22"></i>
                                        </span>
                                    </button>
                                </h2>

                                <div id="itemForceAssignments" class="accordion-collapse collapse">
                                    <div class="accordion-body">

                                        <div id="forceAssignmentDiv"></div>

                                    </div>
                                </div>

                            </div>
                            <div id="evaluationPartiesContainer"></div>

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#itemAllOpenRequests">
                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="las la-list-alt text-primary fs-25"></i>
                                            <span class="fw-semibold @ConstantKeys.EvaluationForm.lblAllOpenRequests"></span>
                                        </div>
                                        <span class="toggle-icon"><i class="la la-angle-up fs-22"></i></span>
                                    </button>
                                </h2>

                                <div id="itemAllOpenRequests" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        <input id="allOpenRequestsSearch"
                                               type="text"
                                               class="form-control mb-3 "
                                               placeholder="بحث..." />

                                        <div id="allOpenRequestsTable"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

