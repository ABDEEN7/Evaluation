                                    <div id="Requestbtns" class="d-flex justify-content-end gap-2"></div>
                                </div>
                            </div>

                        </form>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="actionTransactionsdetailsModal" tabindex="-1" aria-labelledby="actionTransactionsdetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-body-tall">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title @ConstantKeys.WebAppRequest.actionTransactionsdetailsLabel" id="actionTransactionsdetailsLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <label class="@ConstantKeys.WebAppRequest.lblRemarks"></label>
                <textarea id="testRemarks" class="form-control" rows="4" wrap="soft" readonly></textarea>
