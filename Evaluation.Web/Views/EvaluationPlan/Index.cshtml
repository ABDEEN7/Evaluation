            </div>
            <div class="modal-body">

                <label class="@ConstantKeys.WebAppRequest.lblRemarks"></label>
                <textarea id="testRemarks" class="form-control" rows="4" wrap="soft" readonly></textarea>
                <div id="attachmentsSection"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary @ConstantKeys.WebAppRequest.lblCloseModal" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="EvaluationfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-body-tall">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title @ConstantKeys.WebAppRequest.lblEvaluationFileHeader"
