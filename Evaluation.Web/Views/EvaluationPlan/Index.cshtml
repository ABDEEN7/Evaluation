<section id="evaluation" class="banner px-0 ">
    <div class="container-fluid container-xxxl">
        <div class="row">
            <div class="col-lg-12">
                <ul class="nav nav-tabs row main-tabs bg-grey">
                    <li id="tabEvaluationPlans" class="nav-item col-md-4">
                        <a class="nav-link text-center active fs-6" data-bs-toggle="tab" href="#tab-plans">
                            <h4 class="mb-0">خطط التقييم</h4>
                        </a>
                    </li>

                    <li id="tabEvaluationOperations" class="nav-item col-md-4">
                        <a class="nav-link fs-6 text-center " data-bs-toggle="tab" href="#tab-operations">
                            <h4 class="mb-0">عمليات التقييم</h4>
                        </a>
                    </li>

                    <li id="tabSchools" class="nav-item col-md-4">
                        <a class="nav-link fs-6 text-center " data-bs-toggle="tab" href="#tab-schools">
                            <h4 class="mb-0">المدارس</h4>
                        </a>
                    </li>

                </ul>
            </div>

            <div class="col-lg-12">
                <div class="tab-content p-0">

                    <!-- خطط التقييم -->
                    <div id="tab-plans" class="tab-pane fade show active">
                        <ul class="nav nav-tabs sub-tabs mt-3">
                            <li class="nav-item">
                                <a class="nav-link active fs-6" data-bs-toggle="tab" href="#tab-plan-requests">
                                    طلبات خطة التقييم
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fs-6" data-bs-toggle="tab" href="#tab-plan-details">
                                    خطة التقييم
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content mt-3">
                            <div id="tab-plan-requests" class="tab-pane fade show active">
                                <partial name="_PartialEvaluationPlanRequests" />
                            </div>

                            <div id="tab-plan-details" class="tab-pane fade">
                                <partial name="_PartialEvaluationPlans" />
                            </div>
                        </div>
                    </div>

                    <!-- عمليات التقييم -->
                    <div id="tab-operations" class="tab-pane fade">
                        <partial name="_PartialEvaluationOperations" />
                    </div>

                    <!-- المدارس -->
                    <div id="tab-schools" class="tab-pane fade">
                        <partial name="_PartialSchools" />
                    </div>

                  

                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="evaluationRequestDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header align-items-start border-0">
                <div class="w-100">
                    <div class="row align-items-start">
                        <div class="col-md-9">
                            <div class="d-flex gap-3 align-items-center mb-2 heading">
                                <i class="la la-angle-left fs-32"></i>
                                <div>
                                    <h3 class="fw-bold m-0" id="evaluationRequestModalLabel"></h3>

                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item">
                                                <a href="#" id="breadcrumbSchoolName">مدرسة</a>
                                            </li>
                                            <li class="breadcrumb-item active" aria-current="page">
                                                رقم الطلب:
                                                <strong id="evaluationRequestNoText"></strong>
                                            </li>
                                        </ol>
                                    </nav>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex justify-content-end align-items-start gap-2">
                            <div class="dropdown" id="actions-container"></div>

                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="la la-close mt-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body py-0">

                <div class="card card-table mb-4">
                    <div class="card-body">

                        <div class="accordion" id="customAccordion">

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#itemSchool"
                                            aria-expanded="true">
                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="la la-building text-primary fs-25"></i>
                                            <span class="fw-semibold">بيانات المدرسة</span>
                                        </div>
                                        <span class="toggle-icon"><i class="la la-angle-up fs-22"></i></span>
                                    </button>
                                </h2>

                                <div id="itemSchool" class="accordion-collapse collapse show">
                                    <div class="accordion-body">
                                        <div id="school-details-container"></div>
                                        <div id="NDAContainerDiv"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#itemForm">
                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="las la-clipboard text-primary fs-25"></i>
                                            <span class="fw-semibold">بيانات النموذج</span>
                                        </div>
                                        <span class="toggle-icon"><i class="la la-angle-up fs-22"></i></span>
                                    </button>
                                </h2>

                                <div id="itemForm" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        <div class="accordion" id="formGroupsAccordion"></div>
                                    </div>
                                </div>
                            </div>

                            <div id="evaluationPartiesContainer"></div>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="planRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header align-items-start border-0">
                <div class="w-100">

                    <div class="row align-items-start">
                        <div class="col-md-9">
                            <div class="d-flex gap-3 align-items-center mb-2 heading">
                                <i class="la la-angle-left fs-32"></i>

                                <div>
                                    <h3 class="fw-bold m-0">
                                        <span id="planRequestModalLabel"></span>
                                        <span class="text-muted"> - </span>
                                        <span class="text-primary">
                                            <i class="fas fa-file-alt me-1"></i>
                                            <span id="planRequestNoText"></span>
                                        </span>
                                    </h3>

                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item">
                                                <a href="#">الخطط</a>
                                            </li>
                                            <li class="breadcrumb-item active" aria-current="page">
                                                تفاصيل الطلب
                                            </li>
                                        </ol>
                                    </nav>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex justify-content-end align-items-start gap-3">
                            <h5 class="fw-semibold m-0" id="planRequestModalSubTitle"></h5>

                            <div class="dropdown" id="plan-actions-container"></div>

                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="la la-close mt-1"></i>
                            </button>
                        </div>
                    </div>

                    <h5 class="fw-semibold mt-2" id="planRequestModalDetailsLabel"></h5>

                </div>
            </div>

            <div class="modal-body py-0">

                <div class="card card-table mb-4">
                    <div class="card-body">

                        <div class="mb-4">
                            <div class="divNotes" id="divNotes"></div>
                            <div class="divTemplates" id="plan-divTemplates"></div>
                        </div>

                        <div class="accordion" id="planRequestViewAccordion">

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header" id="planRequestHeadingDetails">
                                    <button class="accordion-button d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#planRequestCollapseDetails"
                                            aria-expanded="true">

                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="la la-file-alt text-primary fs-25"></i>
                                            <span class="fw-semibold">تفاصيل الطلب</span>
                                        </div>

                                        <span class="toggle-icon">
                                            <i class="la la-angle-up fs-22"></i>
                                        </span>
                                    </button>
                                </h2>

                                <div id="planRequestCollapseDetails"
                                     class="accordion-collapse collapse show"
                                     data-bs-parent="#planRequestViewAccordion">
                                    <div class="accordion-body">
                                        <div id="plan-request-details-container"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item mb-3 rounded">
                                <h2 class="accordion-header" id="planRequestHeadingLogs">
                                    <button class="accordion-button d-flex align-items-center justify-content-between"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#planRequestCollapseLogs"
                                            aria-expanded="true">

                                        <div class="d-flex align-items-center gap-2 fs-18">
                                            <i class="la la-history text-primary fs-25"></i>
                                            <span class="fw-semibold">سجل الإجراءات</span>
                                        </div>

                                        <span class="toggle-icon">
                                            <i class="la la-angle-up fs-22"></i>
                                        </span>
                                    </button>
                                </h2>

                                <div id="planRequestCollapseLogs"
                                     class="accordion-collapse collapse show"
                                     data-bs-parent="#planRequestViewAccordion">
                                    <div class="accordion-body">
                                        <div id="logTableContainer" class="table-responsive"></div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

