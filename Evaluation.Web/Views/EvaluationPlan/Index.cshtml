    <script src="~/js/evaluationplan/createrequest.js"></script>
    <script src="~/lib/uuid/uuid.min.js"></script>
    <script src="~/lib/jstree/3.3.12/jstree.min.js"></script>
    <script src="~/js/schools/schools-details.js"></script>
    
    <script>    
        $(document).ready(async function () {

            await webAppConfigsSetup().Init({
                pageNames: [
                    '@nameof(ConstantKeys.WebAppRequest)',
                    '@nameof(ConstantKeys.WebAppCommon)',
                    '@nameof(ConstantKeys.CreatePlan)',
                    '@nameof(ConstantKeys.EvaluationPlans)',
                    '@nameof(ConstantKeys.EvaluationPlanRequests)',
                    '@nameof(ConstantKeys.EvaluationOperations)',
                    '@nameof(ConstantKeys.EvaluationDetailsModal)',
                    '@nameof(ConstantKeys.EvaluationForm)',
                    '@nameof(ConstantKeys.WebSchools)',
                    '@nameof(ConstantKeys.Assignment)',
                    '@nameof(ConstantKeys.WebAppOrgDetails)',
                    'Exceptions'

                ],
                pages: [
                    '@nameof(ConstantKeys.WebAppCommon)',
                    '@nameof(ConstantKeys.CreatePlan)',
                    '@nameof(ConstantKeys.EvaluationOperations)',
                    '@nameof(ConstantKeys.EvaluationPlanRequests)',
                    'Exceptions'
                ]
            }).then((result) => {
                 permissionsList = result.permissionsList;
                 IsCanUpdatePlan = permissionsList?.some(p =>p === '@ConstantKeys.WebPermissions.EDIT_WEB_PLAN') ?? false;

                 uiControlsSetup().UpdatPageTitle('WebAppScholarship');
                 InitNavbarSection();
                 $('body').show();

                if (!sharedUtility().ExistingToken()) {
                        sharedUtility().RedirectUnauthorized();
                        return;
                    }

              });

            window.formUtility = window.formUtility || {};

            const searchParams = new URLSearchParams(window.location.search);
            const reqId     = searchParams.get('id');
            const serviceId = searchParams.get('serviceId');
            const EvlId     = searchParams.get('Evlid');
            const planId    = searchParams.get('planId');
            const SerReqid  = searchParams.get('SerReqid');

            const hasDeepLink = reqId || EvlId || SerReqid || planId;

            if (hasDeepLink) {
                if (reqId)     openPlanRequestDetails(reqId);
                if (EvlId)     openEvaluationRequestDetails(EvlId);
                if (SerReqid)  openRequestDetails(SerReqid);
                if (planId) {
                    if (IsCanUpdatePlan) {
                        InitializeCreatePlanRequestService(serviceId, planId);
                    } else {
                        InitializePlanDetails(planId);
                    }
                }

                $('#evaluationRequestDetailsModal, #planRequestModal, #RequestModal, #PlanDetailsModal')
                    .one('shown.bs.modal', function () {
                        loadAllListings();
                    });

            } else {
                loadAllListings();
            }

            $('#evaluationRequestDetailsModal').on('hidden.bs.modal', function () {
                formUtility.removeQueryParameter(['Evlid', 'serviceId']);
            });
            $('#planRequestModal').on('hidden.bs.modal', function () {
                formUtility.removeQueryParameter(['id', 'serviceId']);
            });
            $('#RequestModal').on('hidden.bs.modal', function () {
                formUtility.removeQueryParameter(['SerReqid', 'serviceId']);
            });
            $('#PlanDetailsModal').on('hidden.bs.modal', function () {
                formUtility.removeQueryParameter(['planId', 'serviceId']);
            });

            await LoadUserDetails();
            toggleAddEvaluationPlanRequestButton();
            CheckAndResumeSessionTimer();
        });

         function loadAllListings() {
            if (typeof plansListing !== 'undefined')                plansListing.reload();  
            if (typeof schoolsListing !== 'undefined')              schoolsListing.reload();        
            if (typeof evaluationRequestsListing !== 'undefined')   evaluationRequestsListing.reload(); 
            if (typeof planRequestsListing !== 'undefined')         planRequestsListing.reload();    
        }
    </script>


}

