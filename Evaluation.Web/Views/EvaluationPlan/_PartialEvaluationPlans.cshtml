<style>
	#searchPlansBtn {
		white-space: nowrap;
	}

	#planYearFilter.form-select {
		padding-top: 0.5rem !important;
		padding-bottom: 0.5rem !important;
	}
</style>


<div class="filter-section g-3 align-item-end">
	<div class="row p-2 m-2">
		<div class="col-lg-5 col-sm-12">
			<label class="mb-2">السنة الدراسية</label>
			<select id="planYearFilter" class="form-select">
				<option value="">الكل</option>
			</select>
		</div>
		<div class="col-lg-5 col-sm-12 mb-sm-4">
			<label class="mb-2">اسم المدرسة</label>
			<input type="text" id="schoolName" class="form-control" />
		</div>
		<div class="col-lg-2 col-sm-12 d-flex align-items-end justify-content-end align-self-center ms-auto gap-2">
			<button id="filterPlanBtnId" class="btn btn-primary">بحث</button>
			<button id="clearFilterPlanBtnId" class="btn btn-outline-secondary">
				مسح
			</button>
		</div>

	</div>
</div>


<div class="btn-group m-4" role="group" aria-label="View mode">
	<button id="cardViewEvaluationPlans" type="button" class="btn btn-outline-primary active">
		<i class="la la-th-large"></i> عرض كبطاقات
	</button>
	<button id="tblViewEvaluationPlans" type="button" class="btn btn-outline-secondary">
		<i class="la la-list"></i> عرض كجدول
	</button>
</div>

<div class="row p-4">
	<div class="col-md-12">
		<table class="table table-striped table-bordered w-100 application-request card" id="evaluationPlansTable">
			<thead>
				<tr>
					<th>اسم الخطة</th>
					<th>عدد المدارس</th>
					<th>الفترة</th>
					<th>الحالة</th>
					<th>عرض</th>
					<th>إجراءات</th>
				</tr>
			</thead>
			<tbody class="requeststableBody"></tbody>
		</table>
	</div>
</div>