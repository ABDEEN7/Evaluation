@using Evaluation.SharedHelper.Enums
<style>
	#searchPlansBtn {
		white-space: nowrap;
	}

	#planYearFilter.form-select {
		padding-top: 0.5rem !important;
		padding-bottom: 0.5rem !important;
	}
</style>


<div class="filter-section g-3 align-item-end">
	<div class="row p-2 m-2">
		<div class="col-lg-5 col-sm-12">
			<label class="mb-2">@ConstantKeys.EvaluationPlans.AcademicYear</label>
			<select id="planYearFilter" class="form-select">
				<option value="">@ConstantKeys.EvaluationPlans.All</option>
			</select>
		</div>
		<div class="col-lg-5 col-sm-12 mb-sm-4">
			<label class="mb-2">@ConstantKeys.EvaluationPlans.SchoolName</label>
			<input type="text" id="schoolName" class="form-control" />
		</div>
		<div class="col-lg-2 col-sm-12 d-flex align-items-end justify-content-end align-self-center ms-auto gap-2">
			<button id="filterPlanBtnId" class="btn btn-primary">@ConstantKeys.EvaluationPlans.Search</button>
			<button id="clearFilterPlanBtnId" class="btn btn-outline-secondary">
				@ConstantKeys.EvaluationPlans.Clear
			</button>
		</div>

	</div>
</div>


<div class="btn-group m-4" role="group" aria-label="View mode">
	<button id="cardViewEvaluationPlans" type="button" class="btn btn-outline-primary active">
		<i class="la la-th-large"></i> @ConstantKeys.WebAppCommon.lblDisplayAsCards
	</button>
	<button id="tblViewEvaluationPlans" type="button" class="btn btn-outline-secondary">
		<i class="la la-list"></i> @ConstantKeys.WebAppCommon.lblDisplayAsTable
    </button>
</div>

<div class="row p-4">
	<div class="col-md-12">
		<table class="table table-striped table-bordered w-100 application-request card" id="evaluationPlansTable">
			<thead>
				<tr>
					<th>@ConstantKeys.EvaluationPlans.PlanName</th>
					<th>@ConstantKeys.EvaluationPlans.SchoolsCount</th>
					<th>@ConstantKeys.EvaluationPlans.Period</th>
					<th>@ConstantKeys.EvaluationPlans.Status</th>
					<th>@ConstantKeys.EvaluationPlans.View</th>
					<th>@ConstantKeys.EvaluationPlans.Actions</th>
				</tr>
			</thead>
			<tbody class="requeststableBody"></tbody>
		</table>
	</div>
</div>