@using Evaluation.SharedHelper.Enums

<div class="m-4">

    <!-- Toolbar Row -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">

            <!-- Left: View Toggle -->
            <div class="btn-group" role="group" aria-label="View mode">
                <button id="cardViewEvaluationPlans" type="button"
                        class="btn btn-outline-primary active btn-icon-no-text">
                    <i class="la la-th-large"></i>
                </button>
                <button id="tblViewEvaluationPlans" type="button"
                        class="btn btn-outline-secondary btn-icon-no-text">
                    <i class="la la-list"></i>
                </button>
            </div>

            <!-- Right: Filter Toggle Button -->
            <button id="advancedSearchPlansBtn"
                    type="button"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2">
                <i class="la la-filter"></i>
                <span class="@ConstantKeys.EvaluationPlans.Search"></span>
            </button>

        </div>
    </div>

    <!-- Filter Form: hidden by default -->
    <div id="plan-filter-wrapper" style="display:none;">
        <div class="filter-section p-3 mb-3">
            <form id="plan-filter-form-id">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <label class="form-label @ConstantKeys.EvaluationPlans.AcademicYear"></label>
                        <select id="planYearFilter" class="form-select w-100">
                            <option value="" class="@ConstantKeys.EvaluationPlans.All"></option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <label class="form-label @ConstantKeys.EvaluationPlans.SchoolName"></label>
                        <input type="text" id="schoolName" class="form-control" />
                    </div>

                    <div class="col-lg-4 col-md-12 col-sm-12">
                        <div class="d-flex gap-2 justify-content-lg-end justify-content-start flex-wrap">
                            <button id="filterPlanBtnId"
                                    type="button"
                                    class="btn btn-primary @ConstantKeys.EvaluationPlans.Search">
                            </button>
                            <button id="clearFilterPlanBtnId"
                                    type="button"
                                    class="btn btn-outline-secondary @ConstantKeys.EvaluationPlans.Clear">
                            </button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

</div>

<!-- Table -->
<div class="card-body py-0 my-0">
    <div class="row">
        <div class="col-md-12 m-0 p-0">
            <table class="table table-striped table-bordered w-100 application-request card table-card-seperate-styling"
                   id="evaluationPlansTable">
                <thead>
                    <tr>
                        <th class="@ConstantKeys.EvaluationPlans.PlanName"></th>
                        <th class="@ConstantKeys.EvaluationPlans.SchoolsCount"></th>
                        <th class="@ConstantKeys.EvaluationPlans.Period"></th>
                        <th class="@ConstantKeys.EvaluationPlans.Status"></th>
                        <th class="@ConstantKeys.EvaluationPlans.Actions"></th>
                    </tr>
                </thead>
                <tbody class="requeststableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var btn = document.getElementById("advancedSearchPlansBtn");
        var wrapper = document.getElementById("plan-filter-wrapper");

        if (btn && wrapper) {
            btn.addEventListener("click", function () {
                if (wrapper.style.display === "none" || wrapper.style.display === "") {
                    wrapper.style.display = "block";
                    btn.classList.add("active");
                } else {
                    wrapper.style.display = "none";
                    btn.classList.remove("active");
                }
            });
        }

    });
</script>