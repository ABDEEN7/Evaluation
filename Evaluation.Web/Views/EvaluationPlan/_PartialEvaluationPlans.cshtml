<style>
	#searchPlansBtn {
		white-space: nowrap;
	}
</style>

<div class="filter-section mb-3">
	<div class="row">
		<div class="col-md-4">
			<label>السنة الدراسية</label>
			<select id="planYearFilter" class="form-select">
				<option value="">الكل</option>
			</select>
		</div>

		<div class="col-md-4">
			<label>اسم المدرسة</label>
			<input type="text" id="schoolName" class="form-control" />
		</div>

		<div class="col-md-4 d-flex align-items-end justify-content-end">
			<button id="searchPlansBtn" class="btn btn-primary">بحث</button>
		</div>
	</div>
</div>
<div class="btn-group" role="group" aria-label="View mode">
	<button id="cardViewEvaluationPlans" type="button" class="btn btn-outline-primary active">
		<i class="la la-th-large"></i> عرض كبطاقات
	</button>
	<button id="tblViewEvaluationPlans" type="button" class="btn btn-outline-secondary">
		<i class="la la-list"></i> عرض كجدول
	</button>
</div>
<div class="row">
	<div id="card-container"></div>

	<div  class="table-responsive col-md-12">
<div class="table-responsive">
	<table class="table table-striped table-bordered" id="evaluationPlansTable">
		<thead>
			<tr>
				@* <th>رقم الخطة</th> *@
				<th>اسم الخطة</th>
				<th>عدد المدارس</th>
				<th>الفترة</th>
				<th>الحالة</th>
				<th>عرض</th>
				<th>إجراءات</th>
			</tr>
		</thead>
		<tbody></tbody>
	</table>
</div>
</div>
</div>
