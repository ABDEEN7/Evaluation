@using Evaluation.SharedHelper.Enums
<link href="~/assets/css/application-requests.css" rel="stylesheet" asp-append-version="true" />

<div class="filter-section m-4">
    <form id="plan-request-filter-form-id">
        <div class="row g-3 align-items-end">

            <div class="col-lg-4 col-md-6 col-sm-12">
                <label class="form-label @ConstantKeys.EvaluationPlanRequests.lblRequestNo"></label>
                <input id="planRequestNoFilter"
                       class="form-control filter-enter"
                       style="height:45px;" />
            </div>

            <div class="col-lg-4 col-md-6 col-sm-12">
                <label class="form-label @ConstantKeys.EvaluationOperations.Status"></label>
                <select id="planRequestStatusFilter"
                        class="form-select w-100"
                        style="height:45px;">
                </select>
            </div>

            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="d-flex gap-2 justify-content-lg-end justify-content-md-end justify-content-start flex-wrap">
                    <button id="filterPlanRequestBtnsId"
                            type="button"
                            class="btn btn-primary @ConstantKeys.EvaluationPlanRequests.lblSearchPlan">
                    </button>

                    <button id="clearFilterPlanRequestBtnId"
                            type="button"
                            class="btn btn-outline-secondary @ConstantKeys.EvaluationPlanRequests.lblClear">
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>

<div class="card m-4">
    <div class="card-header">
        <div class="row my-4">
            <div class="col-lg-8 col-sm-12">
                <h4 class="m-0 @ConstantKeys.EvaluationPlanRequests.lblPlanRequests"></h4>
            </div>
            <div class="col-lg-4 col-sm-12 text-align-end">
                <button id="btnAddEvaluationPlanRequest"
                        class="add-request-btn btn-with-text-icon">
                    <i class="la la-plus @ConstantKeys.EvaluationPlanRequests.lblAddPlan"></i>
                </button>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-8"></div>
            <div class="col-lg-4 col-sm-12">
                <div class=" d-flex justify-content-end align-items-center gap-3">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button id="cardViewPlanRequest" type="button" class="btn btn-outline-primary active btn-with-text-icon">
                            <i class="la la-th-large @ConstantKeys.WebAppCommon.lblDisplayAsCards"></i>
                        </button>
                        <button id="tblViewPlanRequest" type="button" class="btn btn-outline-secondary btn-with-text-icon">
                            <i class="la la-list @ConstantKeys.WebAppCommon.lblDisplayAsTable"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card-body">
        <div class="filter-section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="d-flex gap-3">
                            <h5 class="m-0 p-0">
                                @*  <button id="advancedSearchBtnRequestsId" class="btn btn-primary">
                                <i class="fa-solid fa-filter"></i>
                                </button> *@
                                @* <span id="lblAdvancedSearchRequestId" class="@ConstantKeys.EvaluationPlanRequests.lblAdvancedSearch"></span> *@
                            </h5>
                        </div>

                        <div class="export-icons">
                            <a id="tblViewRequest"><i class="fa-solid fa-list"></i></a>
                            <a id="cardViewRequest"><i class="fa-solid fa-grip"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FilterRequestsForm" />

            <div class="row">
                <div id="card-container"></div>

                <div id="requestTableDiv" class="table-responsive col-md-12">
                    <table class="table table-striped table-bordered card application-request" cellspacing="0" width="100%" id="planRequestTable">
                        <thead>
                            <tr>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestNo"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestStatus"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestService"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblScholarships"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedDate"></th>
                                @* <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedTime"></th> *@
                            </tr>
                        </thead>
                        <tbody id="requeststableBody" class="requeststableBody"></tbody>
                    </table>
                </div>

                <div id="requestsPagination"></div>
            </div>
        </div>

    </div>
</div>

<div class="row my-3 text-center"></div>
