@using Evaluation.SharedHelper.Enums
<link href="~/assets/css/application-requests.css" rel="stylesheet" asp-append-version="true" />

<div class="filter-section g-3 align-item-end">
	<div class="row">
        <div class="col-md-4">
            <label class="form-label">رقم الطلب</label>
            <input id="planRequestNoFilter" style="height: 45px;" class="form-control filter-enter" />
        </div>
        <div class="col-md-4">
            <label class="form-label">الحالة</label>
            <select id="planRequestStatusFilter" style="height: 45px;" class="form-select w-100">
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2"></div>
        <div class="col-md-4 d-flex align-items-end justify-content-end ms-auto">
			<button id="filterPlanBtnsId" class="btn btn-primary">بحث</button>
			<button id="clearFilterPlanBtnId" class="btn btn-outline-secondary">
                @ConstantKeys.EvaluationPlanRequests.lblClear
			</button>
		</div>

	</div>
</div>
<div class="card mb-4">

    <div class="card-header">
        <div class="row align-items-center">
              <div class="col-md-6">
                <h4 class="m-0">@ConstantKeys.EvaluationPlanRequests.lblPlanRequests</h4>
              </div>
              <div class="col-md-6">
                <div class=" d-flex justify-content-end align-items-center gap-3">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button id="cardViewPlanRequest" type="button" class="btn btn-outline-primary active">
                            <i class="la la-th-large"></i> عرض كبطاقات
                        </button>
                        <button id="tblViewPlanRequest" type="button" class="btn btn-outline-secondary">
                            <i class="la la-list"></i> عرض كجدول
                        </button>
                    </div>
                    <button id="btnAddEvaluationPlanRequest"
                            class="add-request-btn">
                        + @ConstantKeys.EvaluationPlanRequests.lblAddPlan
                    </button>
                </div>
              </div>
         </div>
        
    </div>
    <div class="card-body">
        <div class="filter-section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="d-flex gap-3">
                            <h5 class="m-0 p-0">
                                @*  <button id="advancedSearchBtnRequestsId" class="btn btn-primary">
                            <i class="fa-solid fa-filter"></i>
                        </button> *@
                                @* <span id="lblAdvancedSearchRequestId" class="@ConstantKeys.EvaluationPlanRequests.lblAdvancedSearch"></span> *@
                            </h5>
                        </div>

                        <div class="export-icons">
                            <a id="tblViewRequest"><i class="fa-solid fa-list"></i></a>
                            <a id="cardViewRequest"><i class="fa-solid fa-grip"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FilterRequestsForm" />

            <div class="row">
                <div id="card-container"></div>

                <div id="requestTableDiv" class="table-responsive col-md-12">
                    <table class="table table-striped table-bordered card application-request" cellspacing="0" width="100%" id="planRequestTable">
                        <thead>
                            <tr>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestNo"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestStatus"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestService"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblScholarships"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedDate"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedTime"></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="requeststableBody" class="requeststableBody"></tbody>
                    </table>
                </div>

                <div id="requestsPagination"></div>
            </div>
        </div>

    </div>
</div>



<div class="row my-3 text-center"></div>


