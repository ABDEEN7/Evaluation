@using Evaluation.SharedHelper.Enums
<link href="~/assets/css/application-requests.css" rel="stylesheet" asp-append-version="true" />


<div class="card mb-4">

    <div class="card-header">
        <div class="row align-items-center">
              <div class="col-md-6">
                <h4 class="m-0 @ConstantKeys.EvaluationPlanRequests.lblPlanRequests">طلبات خطة التقييم</h4>
              </div>
              <div class="col-md-6">
                <div class=" d-flex justify-content-end align-items-center gap-3">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button id="cardViewPlanRequest" type="button" class="btn btn-outline-primary active">
                            <i class="la la-th-large"></i> عرض كبطاقات
                        </button>
                        <button id="tblViewPlanRequest" type="button" class="btn btn-outline-secondary">
                            <i class="la la-list"></i> عرض كجدول
                        </button>
                    </div>
                    <button id="btnAddEvaluationPlanRequest"
                            class="add-request-btn @ConstantKeys.EvaluationPlanRequests.lblAddPlan">
                        + إضافة طلب خطة تقييم
                    </button>
                </div>
              </div>
         </div>
        
    </div>
    <div class="card-body">
        <div class="filter-section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="d-flex gap-3">
                            <h5 class="m-0 p-0">
                                @*  <button id="advancedSearchBtnRequestsId" class="btn btn-primary">
                            <i class="fa-solid fa-filter"></i>
                        </button> *@
                                @* <span id="lblAdvancedSearchRequestId" class="@ConstantKeys.EvaluationPlanRequests.lblAdvancedSearch"></span> *@
                            </h5>
                        </div>

                        <div class="export-icons">
                            <a id="tblViewRequest"><i class="fa-solid fa-list"></i></a>
                            <a id="cardViewRequest"><i class="fa-solid fa-grip"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FilterRequestsForm" />

            <div class="row">
                <div id="card-container"></div>

                <div id="requestTableDiv" class="col-md-12">
                    <table class="table table-striped table-bordered card application-request" cellspacing="0" width="100%" id="planRequestTable">
                        <thead>
                            <tr>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestNo"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestStatus"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestService"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblScholarships"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedDate"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedTime"></th>
                                <th></th>
                                <th></th>
                                <th></th>


                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="requeststableBody" class="requeststableBody"></tbody>
                    </table>
                </div>

                <div id="requestsPagination"></div>
            </div>
        </div>

    </div>
</div>



<div class="row my-3 text-center"></div>

<div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen ">
        <div class="modal-content">
            <div class="modal-header justify-content-between flex-wrap flex-column">
                <div class="d-flex justify-content-between flex-wrap w-100">
                    <h5 class="modal-title ">
                        <span id="serviceTitle"></span> -
                        <span id="formModalRequestNo" class="text-primary">
                            <i class="fas fa-file-alt me-1"></i>
                            <span id="requestNoText"></span>
                        </span>
                    </h5>
                    <h5 class="modal-title" id="formModallblScholarshipNo">
                        <i class="fas fa-graduation-cap me-1"></i>
                        <a id="scholarshipLink" href="#" target="_blank"></a>
                    </h5>
                    <div class="d-flex gap-3 align-items-center">
                        <div class="dropdown" id="actions-container"></div>
                        <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <h5 class="modal-title align-items-start @ConstantKeys.EvaluationPlanRequests.lblRequestDetails" id="formModalLabel"></h5>
            </div>

            <div class="modal-body">
                <div class="row my-1 justify-content-center">
                    <div class="col-md-9">
                        <div class="timeline-wrapper">
                            <button class="nav-btn me-3" id="prevBtn"><i class="fas fa-chevron-left"></i></button>
                            <div class="timeline-container overflow-hidden" id="statusTimelineContainer"></div>
                            <button class="nav-btn ms-3" id="nextBtn"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>
                </div>

                <div class="accordion mt-4" id="viewAccordion">
                    <div class="divNotes" id="divNotes"></div>

                    <div class="accordion mt-4" id="schoolEvaluationAccordion">

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingStats">
                                <button class="accordion-button" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseStats"
                                        aria-expanded="true"
                                        aria-controls="collapseStats">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblStatistics"></span>
                                </button>
                            </h2>
                            <div id="collapseStats" class="accordion-collapse collapse show"
                                 aria-labelledby="headingStats"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- محتوى الإحصائيات -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingSchoolData">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseSchoolData"
                                        aria-expanded="false"
                                        aria-controls="collapseSchoolData">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblSchoolData"></span>
                                </button>
                            </h2>
                            <div id="collapseSchoolData" class="accordion-collapse collapse"
                                 aria-labelledby="headingSchoolData"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- بيانات المدرسة التفصيلية -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingSupportFiles">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseSupportFiles"
                                        aria-expanded="false"
                                        aria-controls="collapseSupportFiles">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblSupportingFiles"></span>
                                </button>
                            </h2>
                            <div id="collapseSupportFiles" class="accordion-collapse collapse"
                                 aria-labelledby="headingSupportFiles"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- الملفات الداعمة -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingInterviews">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseInterviews"
                                        aria-expanded="false"
                                        aria-controls="collapseInterviews">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblInterviewsSchedule"></span>
                                </button>
                            </h2>
                            <div id="collapseInterviews" class="accordion-collapse collapse"
                                 aria-labelledby="headingInterviews"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- جدولة المقابلات/المشاهدات -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingEvidence">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseEvidence"
                                        aria-expanded="false"
                                        aria-controls="collapseEvidence">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblEvidenceCollection"></span>
                                </button>
                            </h2>
                            <div id="collapseEvidence" class="accordion-collapse collapse"
                                 aria-labelledby="headingEvidence"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- جمع الأدلة -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingClassroom">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseClassroom"
                                        aria-expanded="false"
                                        aria-controls="collapseClassroom">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblClassroomObservations"></span>
                                </button>
                            </h2>
                            <div id="collapseClassroom" class="accordion-collapse collapse"
                                 aria-labelledby="headingClassroom"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- المشاهدات الصفية -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingSchoolRounds">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseSchoolRounds"
                                        aria-expanded="false"
                                        aria-controls="collapseSchoolRounds">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblSchoolRounds"></span>
                                </button>
                            </h2>
                            <div id="collapseSchoolRounds" class="accordion-collapse collapse"
                                 aria-labelledby="headingSchoolRounds"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- الجولات / الدورات المدرسية -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingLabs">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseLabs"
                                        aria-expanded="false"
                                        aria-controls="collapseLabs">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblLabsVisits"></span>
                                </button>
                            </h2>
                            <div id="collapseLabs" class="accordion-collapse collapse"
                                 aria-labelledby="headingLabs"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- زيارات المختبرات -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingResultsAnalysis">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseResultsAnalysis"
                                        aria-expanded="false"
                                        aria-controls="collapseResultsAnalysis">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblResultsAnalysis"></span>
                                </button>
                            </h2>
                            <div id="collapseResultsAnalysis" class="accordion-collapse collapse"
                                 aria-labelledby="headingResultsAnalysis"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- تحليل المخرجات -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingRealtime">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseRealtime"
                                        aria-expanded="false"
                                        aria-controls="collapseRealtime">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblRealtimeEvaluationSystem"></span>
                                </button>
                            </h2>
                            <div id="collapseRealtime" class="accordion-collapse collapse"
                                 aria-labelledby="headingRealtime"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- نظام التقييم اللحظي -->
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingPeriodicReport">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapsePeriodicReport"
                                        aria-expanded="false"
                                        aria-controls="collapsePeriodicReport">
                                    <span class="@ConstantKeys.EvaluationPlanRequests.lblPeriodicReport"></span>
                                </button>
                            </h2>
                            <div id="collapsePeriodicReport" class="accordion-collapse collapse"
                                 aria-labelledby="headingPeriodicReport"
                                 data-bs-parent="#schoolEvaluationAccordion">
                                <div class="accordion-body">
                                    <!-- التقرير الدوري -->
                                </div>
                            </div>
                        </div>

                    </div>



                    <div class="modal-footer"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="ViewModal" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ActionModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="divNotes" id="ActiondivNotes"></div>
                <div id="user-wrapper">
                    <div id="user-tables"></div>
                </div>

                <form>
                    <div class="row">
                        <div class="col-12">
                            <div id="progress-container"></div>
                            <div class="accordion mt-4" id="actionAccordion">
                                <div id="Action-container-fields"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-end w-100 gap-2" id="actions-container"></div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <div>
                    <button type="button" class="btn btn-secondary @ConstantKeys.EvaluationPlanRequests.lblCloseModal" data-bs-dismiss="modal">Close</button>
                </div>
                <div id="Action-container-button" class="d-flex"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"id="CreatePlanModal" tabindex="-1" aria-labelledby="CreatePlanModalLabel" aria-hidden="true" data-bs-backdrop="static"data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="CreatePlanModalLabel">
                    إنشاء طلب خطة تقييم
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <form id="create-plan-form" autocomplete="off">

                    <div class="row">
                        <div class="col-12">

                            <div id="progress-container"></div>

                            <div class="accordion mt-4" id="accordionExample" hidden>
                                <select id="partyTypeSelect" class="form-select mb-3"></select>

                                <div id="user-wrapper">
                                    <div id="user-tables"></div>
                                </div>
                            </div>

                            <div id="content-container"></div>

                        </div>
                    </div>

                    <div class="row mt-3" id="divForCreatedRequestButtons">
                        <div class="col-12">
                            <div id="Requestbtns"
                                 class="d-flex justify-content-end gap-2">
                            </div>
                        </div>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>


