@using Evaluation.SharedHelper.Enums
<link href="~/assets/css/application-requests.css" rel="stylesheet" asp-append-version="true" />

<div class="m-4">

    <!-- Toolbar Row -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">

            <!-- Left: View Toggle -->
            <div class="btn-group" role="group" aria-label="View mode">
                <button id="cardViewPlanRequest" type="button"
                        class="btn btn-outline-primary active btn-icon-no-text">
                    <i class="la la-th-large"></i>
                </button>
                <button id="tblViewPlanRequest" type="button"
                        class="btn btn-outline-secondary btn-icon-no-text">
                    <i class="la la-list"></i>
                </button>
            </div>

            <!-- Right: Add + Filter buttons -->
            <div class="d-flex gap-2 align-items-center">

                <button id="btnAddEvaluationPlanRequest"
                        type="button"
                        class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="la la-plus"></i>
                    <span class="@ConstantKeys.EvaluationPlanRequests.lblAddPlan"></span>
                </button>

                <button id="advancedSearchPlanRequestBtn"
                        type="button"
                        class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="la la-filter"></i>
                    @* <span class="@ConstantKeys.EvaluationPlanRequests.lblSearchPlan"></span> *@
                </button>

            </div>

        </div>
    </div>

    <!-- Filter Form: hidden by default -->
    <div id="plan-request-filter-wrapper" style="display:none;">
        <div class="filter-section">
            <form id="plan-request-filter-form-id">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <label class="form-label @ConstantKeys.EvaluationPlanRequests.lblRequestNo"></label>
                        <input id="planRequestNoFilter"
                               class="form-control filter-enter"
                               style="height:45px;" />
                    </div>

                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <label class="form-label @ConstantKeys.EvaluationOperations.Status"></label>
                        <select id="planRequestStatusFilter"
                                class="form-select w-100"
                                style="height:45px;">
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-12 col-sm-12">
                        <div class="d-flex gap-2 justify-content-lg-end justify-content-start flex-wrap">
                            <button id="filterPlanRequestBtnsId"
                                    type="button"
                                    class="btn btn-primary @ConstantKeys.EvaluationPlanRequests.lblSearchPlan">
                            </button>
                            <button id="clearFilterPlanRequestBtnId"
                                    type="button"
                                    class="btn btn-outline-secondary @ConstantKeys.EvaluationPlanRequests.lblClear">
                            </button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

</div>

<!-- Table -->
<div class="card-body p-0 m-0">
    <div class="row m-0 p-0">
        <div id="card-container" class="m-0 p-0"></div>

        <div id="requestTableDiv" class="table-responsive col-md-12 m-0 p-0">
            <table class="table table-striped table-bordered application-request table-card-seperate-styling p-0 m-0"
                   cellspacing="0"
                   width="100%"
                   id="planRequestTable">
                
                <thead>
                    <tr>
                        <th>Service Name</th>
                        <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestStatus"></th>
                        <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestNo"></th>
                        <th>School Count</th>
                        <th>Plan Name</th>
                        <th>Period</th>
                        <th>Created Date</th>
                        <th>Created Time</th>
                    </tr>
                </thead>

                <tbody id="requeststableBody" class="requeststableBody p-0 m-0"></tbody>
            </table>
        </div>

        <div id="requestsPagination"></div>
    </div>
</div>

<div class="row m-4 text-center"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var btn = document.getElementById("advancedSearchPlanRequestBtn");
        var wrapper = document.getElementById("plan-request-filter-wrapper");

        if (btn && wrapper) {
            btn.addEventListener("click", function () {
                if (wrapper.style.display === "none" || wrapper.style.display === "") {
                    wrapper.style.display = "block";
                    btn.classList.add("active");
                } else {
                    wrapper.style.display = "none";
                    btn.classList.remove("active");
                }
            });
        }

    });
</script>