@using Evaluation.SharedHelper.Enums
<link href="~/assets/css/application-requests.css" rel="stylesheet" asp-append-version="true" />


<div class="card mb-4">

    <div class="card-header">
        <div class="row align-items-center">
              <div class="col-md-6">
                <h4 class="m-0 @ConstantKeys.EvaluationPlanRequests.lblPlanRequests">طلبات خطة التقييم</h4>
              </div>
              <div class="col-md-6">
                <div class=" d-flex justify-content-end align-items-center gap-3">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button id="cardViewPlanRequest" type="button" class="btn btn-outline-primary active">
                            <i class="la la-th-large"></i> عرض كبطاقات
                        </button>
                        <button id="tblViewPlanRequest" type="button" class="btn btn-outline-secondary">
                            <i class="la la-list"></i> عرض كجدول
                        </button>
                    </div>
                    <button id="btnAddEvaluationPlanRequest"
                            class="add-request-btn @ConstantKeys.EvaluationPlanRequests.lblAddPlan">
                        + إضافة طلب خطة تقييم
                    </button>
                </div>
              </div>
         </div>
        
    </div>
    <div class="card-body">
        <div class="filter-section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="d-flex gap-3">
                            <h5 class="m-0 p-0">
                                @*  <button id="advancedSearchBtnRequestsId" class="btn btn-primary">
                            <i class="fa-solid fa-filter"></i>
                        </button> *@
                                @* <span id="lblAdvancedSearchRequestId" class="@ConstantKeys.EvaluationPlanRequests.lblAdvancedSearch"></span> *@
                            </h5>
                        </div>

                        <div class="export-icons">
                            <a id="tblViewRequest"><i class="fa-solid fa-list"></i></a>
                            <a id="cardViewRequest"><i class="fa-solid fa-grip"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FilterRequestsForm" />

            <div class="row">
                <div id="card-container"></div>

                <div id="requestTableDiv" class="col-md-12">
                    <table class="table table-striped table-bordered card application-request" cellspacing="0" width="100%" id="planRequestTable">
                        <thead>
                            <tr>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestNo"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestStatus"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestService"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblScholarships"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedDate"></th>
                                <th class="@ConstantKeys.EvaluationPlanRequests.lblRequestCreatedTime"></th>
                                <th></th>
                                <th></th>
                                <th></th>


                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="requeststableBody" class="requeststableBody"></tbody>
                    </table>
                </div>

                <div id="requestsPagination"></div>
            </div>
        </div>

    </div>
</div>



<div class="row my-3 text-center"></div>


<div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="ViewModal" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ActionModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="divNotes" id="ActiondivNotes"></div>
                <div id="user-wrapper">
                    <div id="user-tables"></div>
                </div>

                <form>
                    <div class="row">
                        <div class="col-12">
                            <div id="progress-container"></div>
                            <div class="accordion mt-4" id="actionAccordion">
                                <div id="Action-container-fields"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-end w-100 gap-2" id="actions-container"></div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <div>
                    <button type="button" class="btn btn-secondary @ConstantKeys.EvaluationPlanRequests.lblCloseModal" data-bs-dismiss="modal">Close</button>
                </div>
                <div id="Action-container-button" class="d-flex"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"id="CreatePlanModal" tabindex="-1" aria-labelledby="CreatePlanModalLabel" aria-hidden="true" data-bs-backdrop="static"data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="CreatePlanModalLabel">
                    إنشاء طلب خطة تقييم
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <form id="create-plan-form" autocomplete="off">

                    <div class="row">
                        <div class="col-12">

                            <div id="progress-container"></div>

                            <div class="accordion mt-4" id="accordionExample" hidden>
                                <select id="partyTypeSelect" class="form-select mb-3"></select>

                                <div id="user-wrapper">
                                    <div id="user-tables"></div>
                                </div>
                            </div>

                            <div id="content-container"></div>

                        </div>
                    </div>

                    <div class="row mt-3" id="divForCreatedRequestButtons">
                        <div class="col-12">
                            <div id="Requestbtns"
                                 class="d-flex justify-content-end gap-2">
                            </div>
                        </div>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>


