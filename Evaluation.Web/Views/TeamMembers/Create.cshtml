@{
    Layout = "_Layout";
}

@section Styles {
    <link href="~/plan-assets/css/style.css" rel="stylesheet">
    <link href="~/plan-assets/vendor/select2/css/select2.min.css" rel="stylesheet">
    <style>
        .marked-for-removal {
            background-color: #ffebee !important;
        }

        .checkbox-item {
            padding: 8px;
            cursor: pointer;
        }

            .checkbox-item:hover {
                background-color: #f5f5f5;
            }

            .checkbox-item input[type="checkbox"] {
                margin-right: 8px;
            }
    </style>
}


@section Scripts {
    <!-- JS Libraries -->
    <script src="~/plan-assets/vendor/js/jquery.min.js"></script>
    <script src="~/plan-assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/plan-assets/vendor/select2/js/select2.min.js"></script>

    <!-- Team Management Script -->
    <script src="~/js/teammemebers/team-member-const.js"></script>
    <script src="~/js/teammemebers/generate-team-member.js"></script>
    <script src="~/js/teammemebers/get-team-members.js"></script>
    <script src="~/js/teammemebers/submit-team-memebers.js"></script>
    <script>
        teamMembersUtility.generateTeamMembers('sss');
        teamMembersLogic.init('sss');
    </script>
}