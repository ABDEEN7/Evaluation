@{
	Layout = "_Layout";
}

<!-- Main Wrapper -->

<section class="login-wrapper">
	<div class="container h-100">
		<div class="row align-items-center h-100">
			<div class="col-lg-6 d-lg-flex d-none">
				<div class="login-background">
					<div class="authentication-card w-100">
						<img src="/assets/img/login-bg.png" alt="Img" class="img-fluid">
						<div class="authen-overlay-content">
							<h2 class="text-white fw-bold"></h2>
							<p class="text-white fs-20 fw-semibold"></p>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12">
				<div class="row align-items-center">
					<form>
						<div class="d-flex flex-column justify-content-center p-4 pb-0">
							<div class="mb-3">
								<h2 class="mb-2">تسجيل الدخول</h2>
								<p class="mb-0">مرحبا بك 👋,  يرجي إدخال البيانات التالية</p>
							</div>
							<div class="mb-3">
								<label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
								<div class="input-group">
									<span class="input-group-text border-end-0 bg-transparent">
										<i class="la la-envelope"></i>

									</span>
									<input type="text" value="" class="form-control form-control-lg border-start-0" placeholder="example@qa.gov.edu" />

								</div>
							</div>
							<div class="mb-3">
								<button type="submit" class="btn btn-primary btn-lg w-100">سجل الدخول</button>
							</div>
						</div>
					</form>
				</div>

			</div>
		</div>
	</div>
</section>


<!-- /Main Wrapper -->
<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="fa-solid fa-arrow-up"></i></a>




@section Scripts {
	<!-- Vendor JS Files -->
	<script src='~/assets/js/jquery.min.js'></script>
	<script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
	<!-- Template Main JS File -->
	<script src="~/assets/js/main.js"></script>

	<script src="~/js/account/login.js" asp-append-version="true"></script>
	<script type="text/javascript">

		$(document).ready(async function () {


			webAppConfigsSetup().Init({
				pageNames: [

				],
				additional_keys: []
			}).then(() => {
				uiControlsSetup().UpdatPageTitle();
				// debugger
				if (sharedUtility().ExistingToken()) {
					let TempMessage = GetLocalStorageValue(LocalStorageKeys.TempMessage);
					if (TempMessage) {
						notificationUtil.success(TempMessage);
						SetLocalStorageValue(LocalStorageKeys.TempMessage, '');
					}


					TempMessage = GetLocalStorageValue(LocalStorageKeys.ErrorTempMessage);
					if (TempMessage) {
						notificationUtil.error(TempMessage);
						SetLocalStorageValue(LocalStorageKeys.ErrorTempMessage, '');
					}

					sharedUtility().RedirectToUrl(ConstantUrls.Home);
				}


			});





		});



	</script>
}