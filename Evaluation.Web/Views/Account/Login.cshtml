<section class="login-wrapper">
            <div class="container h-100">
                <div class="row align-items-center h-100">
					<div class="col-lg-6 d-lg-flex d-none">
						<div class="login-background">
							<div class="authentication-card w-100">
								<img src="/assets/img/login-bg.png" alt="Img" class="img-fluid">
								<div class="authen-overlay-content">
									<h2 class="text-white fw-bold">هذا النص يمكن ان يستبدل</h2>
									<p class="text-white fs-20 fw-semibold">هذا النص يمكن أن يستبدل في هذه المساحه هذا النص يمكن أن يستبدل في هذه المساحه</p>
								</div>
							</div>
						</div>
					</div>
                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <div class="row align-items-center">
                            <form id="LoginForm" onsubmit="return false;">
                                <div class="d-flex flex-column justify-content-center p-4 pb-0">

                                    <!-- STEP 1: email/QID -->
                                    <div id="LoginPart1Id">
                                        <div class="mb-3">
                                            <h2 class="mb-2">تسجيل الدخول</h2>
                                            <p class="mb-0">مرحبا بك 👋, يرجي إدخال البيانات التالية</p>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text border-end-0 bg-transparent">
                                                    <i class="la la-envelope"></i>
                                                </span>
                                                <input id="Email" type="text" class="form-control form-control-lg border-start-0"
                                                       placeholder="example@qa.gov.edu" />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <button id="ContinueBtnId" type="button" class="btn btn-primary btn-lg w-100">
                                                متابعة
                                            </button>
                                        </div>
                                    </div>

                                  
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </section>

