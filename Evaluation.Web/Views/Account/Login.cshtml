@using Evaluation.SharedHelper.Enums
@using Evaluation.Web.Models.Account
@model LoginViewModel

@{

}

<!-- ======= Features Section ======= -->
<section class="login-wrapper section">
    <div id="login-section" class="login-signup">
        <div class="container mt-5" data-aos="fade-up">
            <div class="row align-items-center justify-content-center">
                <div class="col-xl-5 col-lg-6 col-md-8">
                    <div class="card">
                        <div class="card-body mx-xl-3 mx-lg-2 mt-5 py-4">
                            <div class="icon position-absolute top-0 start-50 translate-middle">
                                <img alt="" src="@Url.Content("~/assets/img/login.png")" class="img-fluid">
                            </div>

                            <form id="loginForm" asp-action="Login" method="post">
                                <input asp-for="RedirectUrl" type="hidden" class="form-control" required id="RedirectUrl" />
                                <div id="LoginPart1Id">

                                    <div class="mb-2">
                                        <label class="form-label @ConstantKeys.WebAppLoginPage.lblEmail">{{#EMAIL#}}</label>
                                        <input asp-for="Email" placeholder="{{#Email#}}" class="form-control @ConstantKeys.WebAppLoginPage.lblEmail" required id="Email" />
                                        <span asp-validation-for="Email" class="text-danger" />
                                    </div>
                                    <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
                                        <a asp-action="ForgetPassword" class="fs-12 @ConstantKeys.WebAppLoginPage.lblForgotPasswordQuestion" style="line-height:15px">{{#Forgot Password?#}}</a>

                                        <a asp-action="MobileResetPassword" class="fs-12 @ConstantKeys.WebAppLoginPage.lblMobileResetPassword" style="line-height:15px">{{#Forgot Password?#}}</a>
                                    </div>

                                    <div class="d-flex justify-content-between flex-wrap  gap-2">
                                        <a href="/@responseInfo.Lang/Account/Register" class="btn btn-secondary btn-m-width @ConstantKeys.WebAppLoginPage.lblRegisterNewAccount">{{#Register#}}</a>
                                        <button type="button" class="btn btn-primary btn-m-width @ConstantKeys.WebAppLoginPage.lblContinue" id="ContinueBtnId">{{#Continue#}}</button>
                                    </div>
                                </div>

                                <div id="LoginPart2Id" style="display:none;">
                                    <div class="mb-4">
                                        <label class="form-label @ConstantKeys.WebAppLoginPage.lblPassword">{{#PASSWORD#}}</label>
                                        <input asp-for="Password" placeholder="{{#PASSWORD#}}" class="form-control @ConstantKeys.WebAppLoginPage.lblPassword" required id="Password" />
                                        <span asp-validation-for="Password" class="text-danger" />
                                    </div>
                                    <div class="d-flex justify-content-between mb-3">
                                        <button type="button" class="btn btn-secondary btn-m-width @ConstantKeys.WebAppLoginPage.lblBackToEmail" id="BackToEmailId">{{#BACK TO EMAIL#}}</button>

                                        <button type="button" class="btn btn-primary btn-m-width @ConstantKeys.WebAppLoginPage.lblLoginBtn" id="LoginBtnId">{{#LOGIN#}}</button>

                                    </div>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!-- End Features Section -->
@section Scripts {

    <script src="~/js/account/login.js" asp-append-version="true"></script>
    <script type="text/javascript">

        $(document).ready(async function () {


            webAppConfigsSetup().Init({
                pageNames: [
                    'Exceptions',
                    '@nameof(ConstantKeys.WebAppCommon)',
                    '@nameof(ConstantKeys.WebAppLoginPage)'
                ],
                additional_keys: []
            }).then(() => {
                uiControlsSetup().UpdatPageTitle();
                // debugger
                if (sharedUtility().ExistingToken()) {
                    let TempMessage = GetLocalStorageValue(LocalStorageKeys.TempMessage);
                    if (TempMessage) {
                        notificationUtil.success(TempMessage);
                        SetLocalStorageValue(LocalStorageKeys.TempMessage, '');
                    }


                    TempMessage = GetLocalStorageValue(LocalStorageKeys.ErrorTempMessage);
                    if (TempMessage) {
                        notificationUtil.error(TempMessage);
                        SetLocalStorageValue(LocalStorageKeys.ErrorTempMessage, '');
                    }

                    sharedUtility().RedirectToUrl(ConstantUrls.Home);
                }


            });





        });



    </script>
}