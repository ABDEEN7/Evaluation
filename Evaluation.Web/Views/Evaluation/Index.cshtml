@using Evaluation.SharedHelper.Enums
@{
    ViewData["Title"] = "Evaluation Form";
}
@section styles {
   
    <link href="assets/vendor/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet">

    <!-- Custom Styles -->
    <link href="assets/css/style.css" rel="stylesheet">
    <link href="assets/css/style-ar.css" rel="stylesheet">

    <link href="assets/css/istemara-styles.css" rel="stylesheet">
    <link href="~/lib/tabulator/css/tabulator.min.css" rel="stylesheet" />
    <link href="~/lib/tabulator/css/tabulator.css" rel="stylesheet" />
    <link href="~/assets/css/tabulator-styling.css.css" rel="stylesheet" />
}
<section class="evaluation-form">
<div class="sub-page-container">
    <section id="tbltemplatecontainer" class="section-container">
        <div class="card app-card">
            <div class="card-header justify-content-end d-flex align-items-center bg-light">

                <button id="btnaddcontent" type="button" class="btn btn-primary ADDRECORD">
                        <i class="fa fa-plus-circle"></i> 
                    </button>
               

            </div>
            <div class="card-body">

                <div id="view-container"></div>
            </div>
        </div>
    </section>

    <section class="display-none" id="formsection">
        <div class="card app-card">
            <form enctype="multipart/form-data" id="app-form">
                <input id="Id" hidden />
                <input id="evalformidvalue" hidden />
                <input id="evalformitemidvalue" hidden />
                <div class="card-body" >
                    <div id="formcontent"></div>
                    <div id="itemcontent">
                        <button type="button" id="btnAddParent" class="btn btn-danger mb-2 ADDPARENT"></button>

                        <table id="formitemTable" class="table table-bordered">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width:40px"></th>
                                    <th style="width:100px"></th>
                                    <th class="EvalFormsNameAr"></th>
                                    <th class="EvalFormsNameEn"></th>
                                    <th style="display:none"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end gap-2" id="action-container">
                        <button type="button" id="btn-back" class="btn btn-secondary BACKBUTTON"></button>
                        <button type="button" id="btn-submit" class="btn btn-primary SAVEBUTTON"></button>
                    </div>
                </div>
            </form>
        </div>
    </section>
    
</div>
<div>
    <input id="formIdValue" hidden />
</div>
</section>
@section Scripts {
    
    <script src="~/js/EvaluationForm/evaluation-form.js" asp-append-version="true"></script>
    <script src="~/lib/tabulator/js/tabulator.js" asp-append-version="true"></script>
    <script>
        $(document).ready(async function () {
           
             if (!sharedUtility().ExistingToken()) {
                sharedUtility().RedirectUnauthorized();
            }
           
            await webAppConfigsSetup().Init({
                pageNames: [
                    '@nameof(ConstantKeys.WebAppCommon)',
                    '@nameof(ConstantKeys.WebAppRequest)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationForm)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationFormItem)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationSubFormItem)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationFormScopes)'
                ],
                 pages: [
                    '@nameof(ConstantKeys.WebAppCommon)',
                    '@nameof(ConstantKeys.WebAppRequest)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationForm)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationFormItem)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationSubFormItem)',
                    '@nameof(ConstantKeys.WebAppPages.WebEvaluationFormScopes)'
                ],
                 permissions: [
                    '@nameof(ConstantKeys.WebPermissions.ADD_WEB_EVALFORMS)',
                    '@nameof(ConstantKeys.WebPermissions.ADD_WEB_FORMITEMS)',,
                    '@nameof(ConstantKeys.WebPermissions.ADD_WEB_SUBFORMITEMS)',
                     '@nameof(ConstantKeys.WebPermissions.ADD_WEB_FORMSCOPES)',
                ],
            }).then((result) => {
                       let lang = sharedUtility().GetCookie('lang');
             
                 uiControlItems = result.uiControlItems.filter(x => x.rowOrder > 0 && x.permissionBackendName=='@ConstantKeys.WebPermissions.ADD_WEB_EVALFORMS');
                 FormItemuiControlItems = result.uiControlItems.filter(x => x.rowOrder > 0 && x.permissionBackendName=='@ConstantKeys.WebPermissions.ADD_WEB_FORMITEMS');
                  SubFormItemuiControlItems = result.uiControlItems.filter(x => x.rowOrder > 0 && x.permissionBackendName=='@ConstantKeys.WebPermissions.ADD_WEB_SUBFORMITEMS');
                   FormScopeuiControlItems = result.uiControlItems.filter(x => x.rowOrder > 0 && x.permissionBackendName=='@ConstantKeys.WebPermissions.ADD_WEB_FORMSCOPES');
                textDir = lang=== "ar" ? "RTL" : "LTR";
                permissionsList = result.permissionsList;
                controlsList = result.controlsList;
                columnList = uiControlItems.filter(x => x.constraint.showInGrid === true && x.control).map(c => ({
                    ...c.constraint,
                    pageName: c.control.pageName
                }));

                settingList = result.settingList;
                targetSetting = result.targetSetting;
                containsOrderNo = result.containsOrderNo;
                controlvalidationlist = uiControlItems;
                FormItemcontrolvalidationlist = FormItemuiControlItems;
                SubFormItemcontrolvalidationlist = SubFormItemuiControlItems;
                FormScopecontrolvalidationlist = FormScopeuiControlItems;
                FormScopecolumnList = FormScopeuiControlItems.filter(x => x.constraint.showInGrid === true && x.control).map(c => ({
                    ...c.constraint,
                    pageName: c.control.pageName
                }));
                //EvalForms
                IsEdit = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.EDIT_WEB_EVALFORMS') ?? false;
                IsDelete = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.DELETE_WEB_EVALFORMS') ?? false;
                 IsAdd = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.ADD_WEB_EVALFORMS') ?? false;
                 //FormItem
                 IsAddFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.ADD_WEB_FORMITEMS') ?? false;
                 IsViewFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.VIEW_WEB_FORMITEMS') ?? false;
                  IsEditFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.EDIT_WEB_FORMITEMS') ?? false;
                   IsDeleteFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.DELETE_WEB_FORMITEMS') ?? false;
                     //SubFormItem
                    IsAddSubFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.ADD_WEB_SUBFORMITEMS') ?? false;
                 IsViewSubFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.VIEW_WEB_SUBFORMITEMS') ?? false;
                  IsEditSubFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.EDIT_WEB_SUBFORMITEMS') ?? false;
                   IsDeleteSubFormItem = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.DELETE_WEB_SUBFORMITEMS') ?? false;
                     //FormScope
                    IsAddFormScope = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.ADD_WEB_FORMSCOPES') ?? false;
                 IsViewFormScope = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.VIEW_WEB_FORMSCOPES') ?? false;
                  IsEditFormScope = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.EDIT_WEB_FORMSCOPES') ?? false;
                   IsDeleteFormScope = permissionsList?.some(p => p === '@ConstantKeys.WebPermissions.DELETE_WEB_FORMSCOPES') ?? false;
                 initTables();
            });

           
        });
    </script>
 

}
