@model PlanViewModel
@{
    Layout = "_Layout";
}

@section Scripts {

    <!-- Core -->
    <script src="~/plan-assets/vendor/jquery/jquery.min.js"></script>
    <script src="~/plan-assets/vendor/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/plan-assets/vendor/select2/js/select2.min.js"></script>

    <!-- Date -->
    <script src="~/plan-assets/vendor/flatpickr/js/flatpickr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>

    <!-- Plan System (ORDER IS CRITICAL) -->
    <script src="~/js/plan/planBuilder/plan.constants.js"></script>
    <script src="~/js/plan/planBuilder/plan.generate-plan-fields.js"></script>

    <script src="~/js/plan/planBuilder/plan.generate-components.js"></script>
    <script src="~/js/plan/planBuilder/plan.main-handler.js"></script>
    <!-- ENTRY POINT -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            planUtility.generatePlanFields();
                PlanHandler.init(
            '@Model.ActionType',
            false,
            @Html.Raw(Json.Serialize(Model.PlanId))
        );
        });
    </script>

}
