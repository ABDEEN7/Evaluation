@model PlanViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.ActionType == "CREATE" ? "إنشاء خطة جديدة" :
                        Model.ActionType == "EDIT" ? "تعديل الخطة" :
                        Model.ActionType == "APPROVE" ? "اعتماد الخطة" :
                        "عرض الخطة";
}

<!-- Pass constants to JavaScript -->
<script>
    window.PLAN_PAGE_CONFIG = {
        renderType: '@Model.RenderType',
        actionType: '@Model.ActionType',
        planId: @(Model.PlanId?.ToString() ?? "null"),
        oldPlanId: @(Model.OldPlanId?.ToString() ?? "null"),
        showApprovalButtons: @(Model.ShowApprovalButtons.ToString().ToLower())
    };
</script>

<style>
    .date-list li.blocked {
        background: #ffe6e6;
        border-left-color: #ff4444;
        text-decoration: line-through;
        opacity: 0.6;
    }

    .flatpickr-day.blocked {
        background: #fff8e1 !important;
        border-color: #ff4444 !important;
        font-weight: bold;
    }

    /* Comparison View Styles */
    .comparison-container {
        margin-top: 20px;
    }

        .comparison-container .col-md-6 {
            padding: 15px;
        }

        .comparison-container .border-end {
            border-right: 2px solid #dee2e6 !important;
        }

        /* Highlight changes in comparison view */
        .comparison-container .changed-field {
            background-color: #fff3cd;
            border-left: 3px solid #ffc107;
            padding-left: 10px;
        }

        .comparison-container .removed-field {
            background-color: #f8d7da;
            text-decoration: line-through;
        }

        .comparison-container .added-field {
            background-color: #d4edda;
            border-left: 3px solid #28a745;
            padding-left: 10px;
        }
</style>

<main class="main-content">
    <section>
        <div class="card card-table mb-4">
            <div class="card-body">
                <h3>@ViewData["Title"]</h3>

                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">الرئيسية</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Plan")">الخطط</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>

                <!-- Plan Status (if editing/viewing) -->
                @if (Model.Plan != null)
                {
                    <div class="alert alert-info mb-4">
                        <strong>حالة الخطة:</strong> @Model.Plan.Status
                        <br />
                        <strong>تاريخ الإنشاء:</strong> @Model.Plan.CreatedDate.ToString("yyyy-MM-dd")
                        <br />
                        <strong>المنشئ:</strong> @Model.Plan.CreatedBy
                    </div>
                }

                <!-- Plan Creation/Edit Form Container -->
                <div id="planFormContainer" class="card-table mb-4">
                    <div class="card-body p-0">
                        <div class="form-container pb-0">
                            @if (Model.RenderType != "comparison")
                            {
                                <h4 class="mb-4 text-primary">
                                    @(Model.ActionType == "CREATE" ? "إنشاء الخطة" :
                                                                    Model.ActionType == "EDIT" ? "تعديل الخطة" : "تفاصيل الخطة")
                            </h4>
                                                        }
                            <!-- Form will be dynamically generated by JavaScript -->
                        </div>
                    </div>
                </div>

                <!-- Schools Selection Table (Only for CREATE and EDIT modes) -->
                @if (Model.RenderType != "comparison" && (Model.ActionType == "CREATE" || Model.ActionType == "EDIT"))
                {
                    <div class="card card-table">
                        <div class="card-body">
                            <!-- Search and Filter Row -->
                            <div class="row align-items-center mb-3">
                                <div class="col-xl-7 col-lg-5">
                                    <h4 class="mb-3 mb-lg-0">تحديد المدارس</h4>
                                </div>
                                <div class="col-xl-5 col-lg-7">
                                    <div class="row">
                                        <!-- Search Box -->
                                        <div class="col-xl-8 col-lg-8 col-md-8 mb-3">
                                            <div class="d-flex justify-content-end custom-search">
                                                <div class="input-group">
                                                    <span class="input-group-text border-end-0 bg-transparent">
                                                        <i class="las la-search"></i>
                                                    </span>
                                                    <input type="text"
                                                           id="customSearch"
                                                           class="form-control form-control-lg border-start-0 ps-0"
                                                           placeholder="ابحث هنا...">
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Filter Button -->
                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                            <button class="btn filterbtn"
                                                    data-bs-toggle="offcanvas"
                                                    data-bs-target="#filterOffcanvas">
                                                <i class="la la-filter"></i> تصفية
                                                <span class="badge bg-primary rounded-pill mx-2">0</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Schools Table -->
                            <div class="table-card rounded overflow-hidden">
                                <div class="table-responsive">
                                    <table id="planTable" class="table table-bordered table-hover align-middle w-100">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 50px;">
                                                    <label class="custom-checkbox">
                                                        <input type="checkbox" id="selectAll">
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </th>
                                                <th>اسم المدرسة</th>
                                                <th style="width: 250px;">تاريخ الزيارة</th>
                                                <th style="width: 120px;">تاريخ آخر تقييم</th>
                                                <th style="width: 150px;">نوع الزيارة</th>
                                                <th style="width: 120px;">العام الأكاديمي</th>
                                                <th style="width: 80px;">الإجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Data will be populated by JavaScript -->
                                            <tr>
                                                <td colspan="7" class="text-center py-5">
                                                    <div class="spinner-border text-primary" role="status">
                                                        <span class="visually-hidden">جاري التحميل...</span>
                                                    </div>
                                                    <p class="mt-2 text-muted">جاري تحميل البيانات...</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Action Buttons and Pagination -->
                            <div class="row mt-3">
                                <div class="col-md-6 mt-3">
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <a href="#" id="openSaveModal" class="btn btn-primary mw-200" type="button">
                                            <i class="la la-bookmark"></i> حفظ
                                        </a>
                                        <a href="@Url.Action("Index", "Plan")" class="btn btn-outline-primary">
                                            عرض الخطط
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-6 text-end">
                                    <!-- Pagination Container -->
                                    <div class="d-flex justify-content-end align-items-center">
                                        <div id="dtPagination"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Approval Buttons (for APPROVE and COMPARISON modes) -->
                @if (Model.ActionType == "APPROVE" || Model.ActionType == "APPROVE_WITH_CHANGES")
                {
                    <div class="card card-table mt-4">
                        <div class="card-body">
                            <h5 class="mb-3">إجراءات الاعتماد</h5>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success mw-200" id="btnApprovePlan">
                                    <i class="la la-check"></i> اعتماد الخطة
                                </button>
                                <button type="button" class="btn btn-danger mw-200" id="btnRejectPlan"
                                        data-bs-toggle="modal" data-bs-target="#reject-modal">
                                    <i class="la la-times"></i> رفض الخطة
                                </button>
                                <button type="button" class="btn btn-warning mw-200" id="btnRequestChanges"
                                        data-bs-toggle="modal" data-bs-target="#changes-modal">
                                    <i class="la la-edit"></i> طلب تعديلات
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</main>

<!-- Filter Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas">
    <div class="offcanvas-header justify-content-between p-4">
        <h5 class="offcanvas-title border d-flex align-items-center w-75 justify-content-between px-3 py-2 rounded">
            <span>تصفية النتائج</span>
            <i class="la la-filter"></i>
        </h5>
        <button type="button"
                class="btn btn-lg border d-flex align-items-center h-100"
                data-bs-dismiss="offcanvas">
            <i class="la la-angle-right"></i>
        </button>
    </div>
    <div class="offcanvas-body p-4">
        <form id="filterForm">
            <!-- School Name Filter -->
            <div class="mb-3">
                <label class="form-label">اسم المدرسة</label>
                <input type="text"
                       class="form-control"
                       id="filterSchoolName"
                       name="SchoolName"
                       placeholder="أكتب هنا...">
            </div>
            <hr>

            <!-- Last Evaluation Date Filter -->
            <div class="mb-3">
                <label class="form-label">تاريخ آخر تقييم</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="la la-calendar"></i></span>
                    <input type="text"
                           class="form-control datepicker-single"
                           id="filterLastEvalDate"
                           name="LastEvalDate"
                           placeholder="اختر التاريخ">
                </div>
            </div>
            <hr>

            <!-- Creation Date Filter -->
            <div class="mb-3">
                <label class="form-label">تاريخ الإنشاء</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="la la-calendar"></i></span>
                    <input type="text"
                           class="form-control datepicker-any"
                           id="filterCreatedDate"
                           name="CreatedDate"
                           placeholder="اختر التاريخ">
                </div>
            </div>
            <hr>

            <!-- Next Evaluation Date Filter -->
            <div class="mb-3">
                <label class="form-label">تاريخ التقييم القادم</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="la la-calendar"></i></span>
                    <input type="text"
                           class="form-control datepicker-single"
                           id="filterNextEvalDate"
                           name="NextEvalDate"
                           placeholder="اختر التاريخ">
                </div>
            </div>
            <hr>

            <!-- Previous Result Filter -->
            <div class="mb-3">
                <label class="form-label">النتيجة السابقة</label>
                <select class="form-control"
                        id="filterPreviousResult"
                        name="PreviousResult">
                    <option value="">الكل</option>
                    <option value="ممتاز">ممتاز</option>
                    <option value="جيد جداً">جيد جداً</option>
                    <option value="جيد">جيد</option>
                    <option value="مقبول">مقبول</option>
                    <option value="ضعيف">ضعيف</option>
                </select>
            </div>
            <hr>

            <!-- Visit Type Filter -->
            <div class="mb-3">
                <label class="form-label">نوع الزيارة</label>
                <select class="form-control"
                        id="filterVisitType"
                        name="VisitType">
                    <option value="">الكل</option>
                    <option value="دوري">دوري</option>
                    <option value="استثنائي">استثنائي</option>
                    <option value="زيارة">زيارة</option>
                </select>
            </div>

            <!-- Filter Actions -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="la la-check"></i> تطبيق
                </button>
                <button type="button" class="btn btn-outline-primary w-100" id="clearFiltersBtn">
                    <i class="la la-trash"></i> مسح
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmation-modal" tabindex="-1" aria-labelledby="confirmation-modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body py-0">
                <div class="row">
                    <div class="col-md-12 py-4 text-center">
                        <div class="social-icon bg-primary text-white fw-normal m-auto mb-3">
                            <i class="la la-city"></i>
                        </div>
                        <h5 class="fw-bold text-primary mb-3" id="confirmationMessage">
                            تم تحديد (00) مدرسة للإضافة للخطة
                        </h5>
                        <p>هل ترغب في حفظ الخطة؟</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button"
                                    class="btn btn-primary mw-200"
                                    id="btn-submit">
                                <i class="la la-bookmark"></i> تأكيد الحفظ
                            </button>
                            <button type="button"
                                    class="btn btn-outline-primary mw-200"
                                    data-bs-dismiss="modal">
                                <i class="la la-window-close"></i> إلغاء
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="reject-modal" tabindex="-1" aria-labelledby="reject-modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">رفض الخطة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">سبب الرفض <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="rejectReason" rows="4"
                              placeholder="يرجى كتابة سبب رفض الخطة..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="confirmReject">
                    <i class="la la-times"></i> تأكيد الرفض
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    إلغاء
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Request Changes Modal -->
<div class="modal fade" id="changes-modal" tabindex="-1" aria-labelledby="changes-modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">طلب تعديلات</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">التعديلات المطلوبة <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="requestedChanges" rows="4"
                              placeholder="يرجى كتابة التعديلات المطلوبة..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" id="confirmRequestChanges">
                    <i class="la la-edit"></i> إرسال الطلب
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    إلغاء
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Month Select Plugin CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/style.css">
    <!-- Custom CSS -->
    <link href="~/plan-assets/css/style.css" rel="stylesheet">
}


@section Scripts {
    <!-- Core Libraries -->
    <script src="~/plan-assets/vendor/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/plan-assets/vendor/select2/js/select2.min.js"></script>

    <!-- Flatpickr JS -->
    <script src="~/plan-assets/vendor/flatpickr/js/flatpickr.js"></script>
    <!-- Flatpickr Arabic Locale -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <!-- Month Select Plugin JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>

    <!-- Shared JS -->
    <script src="~/js/shared/populate-ui-control.js"></script>

    <!-- Plan System Files (in order) -->
    <script src="~/js/plan/planBuilder/plan.constants.js"></script>
    <script src="~/js/plan/planBuilder/plan.generate-components.js"></script>
    <script src="~/js/plan/planBuilder/plan.main-handler.js"></script>
    <script src="~/js/plan/submit-evaluation-plan.js"></script>
}

@await Component.InvokeAsync("SchoolDetailsModal", new { modalId = "schoolDetailsModal", title = "تفاصيل المدرسة", body = "" })
