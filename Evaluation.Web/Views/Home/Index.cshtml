@{
    Layout = "_Layout";
}


<main>
    <!-- Banner Section -->
    <section class="banner p-0 ">
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                <!-- Slide 1 -->
                <div class="swiper-slide">
                    <img src="~/assets/img/slider1.jpg" alt="Banner Image">
                    <div class="banner-content">
                        <h1 class="text-white mb-4">منصة تقييم المنشآت التعليمية</h1>
                        <p>نعمل على الارتقاء بجودة التعليم في قطر من خلال تقييم شامل ومتكامل للمؤسسات التعليمية، استنادًا إلى معايير عالمية ومنسجمًا مع رؤية قطر الوطنية 2030، بما يضمن توفير بيئة تعليمية متميزة لأبنائنا.</p>
                    </div>
                </div>
                <!-- Slide 2 -->
                <div class="swiper-slide">
                    <img src="~/assets/img/slider1.jpg" alt="Banner Image">
                    <div class="banner-content">
                        <h1 class="text-white mb-4">منصة تقييم المنشآت التعليمية</h1>
                        <p>نعمل على الارتقاء بجودة التعليم في قطر من خلال تقييم شامل ومتكامل للمؤسسات التعليمية، استنادًا إلى معايير عالمية ومنسجمًا مع رؤية قطر الوطنية 2030، بما يضمن توفير بيئة تعليمية متميزة لأبنائنا.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <section>
        <div class="container">
            <div class="row mb-3">
                <div class="col-md-9">
                    <h4 class="fw-bold mb-3">المنشآت التعليمية</h4>
                    <p>الجهات المعنية بقياس ومتابعة جودة العملية التعليمية والأداء المدرسي لضمان تحقيق معايير التميز والتحسين المستمر.</p>
                </div>
                <div class="col-md-3 text-md-end mt-3 mt-md-0">
                    <!-- Single Toggle Buttons -->
                    <div class="btn-group toggle-btns" role="group">
                        <button class="btn toggle-btn active" data-view="card">
                            <i class="bi bi-grid-fill"></i>
                        </button>
                        <button class="btn toggle-btn" data-view="list">
                            <i class="bi bi-list"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <!-- Bootstrap Tabs -->
                    <ul class="nav nav-tabs mb-4 row g-0" id="viewTabs" role="tablist">
             
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="viewTabsContent">
   

                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
<script src="~/js/home/index.js"></script>